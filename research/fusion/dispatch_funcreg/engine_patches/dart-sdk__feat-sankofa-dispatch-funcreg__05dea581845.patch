 // Sankofa CodePush: serialises the current isolate group's class table
 // to a binary file at `path`. Format documented in
 // runtime/vm/sankofa_codepush_emit.cc (header "SCTL", v1). Called from
@@ -113,6 +124,86 @@ intptr_t Dart_SankofaLookupBasePoolIndex(const char* identity);
 // the base dispatch table has no matching entry.
 intptr_t Dart_SankofaLookupBaseDispatchSelectorByName(const char* name);
 
+// ── Device-side patch fusion (Tasks 6/7) ────────────────────────────
+// These are the VM C-API the engine calls on-device to load a patch
+// .vmcode on top of the running base App snapshot. Contract +
+// device flow: research/ENGINE_FUSION_TASKS_6_7.md.
+
+// Stash the base App snapshot mappings. Called once at engine init,
+// before any patch isolate is created. Stored process-globally and
+// read by the isolate-fusion path. The VM snapshot is identical across
+// builds of a Dart version, so vm_data/vm_instr act as a consistency
+// anchor.
+void Dart_SankofaSetBaseSnapshots(const uint8_t* isolate_data,
+                                  const uint8_t* isolate_instructions,
+                                  const uint8_t* vm_data,
+                                  const uint8_t* vm_instructions);
+
+// Parse the LinkTable header that prefixes a patch .vmcode (the format
+// aot_tools LinkTable.toBytes() emits: count u32-BE, then (sim,cpu)
+// u32-BE pairs, zero-padded to 4096). Stashes the sim→cpu map
+// process-globally and returns the 4096-aligned header size — the byte
+// offset where the embedded ELF begins, to pass as Dart_LoadELF's
+// `file_offset`. Returns -1 on a malformed/truncated buffer.
+intptr_t Dart_SankofaReadLinkHeader(const void* mapping, intptr_t size);
+
+// Accessors for the isolate-fusion path (Dart_CreateIsolateGroupWith-
+// BaseSnapshot) and tests. LookupCpuOffset maps a patch (sim) function
+// offset to its base (cpu) offset via the last-read link table, or -1
+// when the function has no base equivalent (it ships in the patch).
+const uint8_t* Dart_SankofaBaseIsolateData();
+const uint8_t* Dart_SankofaBaseIsolateInstructions();
+const uint8_t* Dart_SankofaBaseVmData();
+const uint8_t* Dart_SankofaBaseVmInstructions();
+intptr_t Dart_SankofaLinkTableCount();
+intptr_t Dart_SankofaLookupCpuOffset(intptr_t sim_offset);
+
+// The fuse: resolve a Code's entry point given the patch instructions-image
+// base + the Code's pc_offset. With no patch loaded it's a passthrough
+// (patch_image_start + pc_offset). With a patch, an UNCHANGED Code (offset in
+// the link table) resolves to the base App's executable instructions; a
+// CHANGED Code stays in the patch image. Called from
+// InstructionsTable::EntryPointAt. uintptr_t (not the VM's uword) to keep this
+// header VM-type-free.
+uintptr_t Dart_SankofaResolveEntryPoint(uintptr_t patch_image_start,
+                                        uintptr_t pc_offset);
+
+// The REVERSE fuse: given a PC that may be in the base image (fused base code
+// runs there), return the equivalent PC inside the patch image (where the
+// isolate's InstructionsTable lives) so PC→Code lookups resolve. Returns 0 if
+// `pc` is not a mapped base-image PC (caller treats it as a patch-image PC).
+// Called from InstructionsTable::FindCode / FindEntry / FindStackMap.
+uintptr_t Dart_SankofaBasePcToPatchPc(uintptr_t patch_image_start,
+                                      uintptr_t pc);
+
+// Diagnostics: entry-point resolutions that hit the base image (unchanged
+// code) vs stayed in the patch image (changed code) since the link table
+// was loaded. Lets a self-test confirm the fuse actually fired.
+void Dart_SankofaResolverStats(intptr_t* base_hits, intptr_t* patch_hits);
+
+// ── Hybrid-snapshot merge mode (build-time) ──────────────────────────
+// Process-global toggle read by BytecodeLoader::LoadBytecode. When set, the
+// loader attaches a bytecode component's functions onto the EXISTING base
+// program (resolve-by-canonical-name) instead of declaring new libraries
+// (which would throw "already loaded"). gen_snapshot sets this around the
+// Dart_LoadLibraryFromBytecode that merges changed-function bytecode into the
+// base AOT program. Kept here (not dart_api*.h) because those are in the
+// snapshot-version-hash set; read.cc/bytecode_reader.cc are not.
+void Dart_SankofaSetBytecodeMerge(bool enabled);
+bool Dart_SankofaBytecodeMerge();
+
+// ── Dispatch-table reroute (apply path) ──────────────────────────────
+// |name| ("function" or "Class.method") resolves in the isolate's ROOT library.
+// Capture a function's code entry-point BEFORE transplanting it to bytecode
+// (its virtual-method dispatch slots currently hold this entry).
