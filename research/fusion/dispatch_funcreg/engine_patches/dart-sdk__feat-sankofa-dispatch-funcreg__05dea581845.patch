+// ── Device-side patch fusion (Tasks 6/7) ────────────────────────────
+//
+// Process-global state set up at engine init / patch load and read by
+// the isolate-fusion path. Single-writer by construction: the engine
+// calls SetBaseSnapshots once before any isolate, and ReadLinkHeader
+// once per patch load on the platform thread — so no locking here (the
+// engine serialises these). Contract: research/ENGINE_FUSION_TASKS_6_7.md.
+namespace {
+
+struct FusionState {
+  const uint8_t* base_isolate_data = nullptr;
+  const uint8_t* base_isolate_instructions = nullptr;
+  const uint8_t* base_vm_data = nullptr;
+  const uint8_t* base_vm_instructions = nullptr;
+  // sim (patch) offset → cpu (base) offset, from the last .vmcode header.
+  std::unordered_map<intptr_t, intptr_t> link;
+  // Inverse, sorted by cpu (base) offset, for the REVERSE PC lookup: when fused
+  // base code runs, a PC is in the base image and the VM's PC→Code machinery
+  // (InstructionsTable::FindCode etc.) must map it back to the patch image's
+  // equivalent PC. Pairs are (cpu_offset, sim_offset) sorted ascending by cpu.
+  std::vector<std::pair<intptr_t, intptr_t>> cpu_sorted;
+  // Diagnostics: how many entry-point resolutions hit the base image
+  // (unchanged code) vs stayed in the patch image (changed code). Lets a
+  // self-test confirm the fuse actually fired rather than passing through.
+  intptr_t resolve_base_hits = 0;
+  intptr_t resolve_patch_hits = 0;
+};
+
+FusionState* Fusion() {
+  static FusionState* state = new FusionState();
+  return state;
+}
+
+// Big-endian u32 read (the LinkTable is emitted big-endian by
+// aot_tools LinkTable.toBytes()).
+uint32_t ReadU32BE(const uint8_t* p) {
+  return (static_cast<uint32_t>(p[0]) << 24) |
+         (static_cast<uint32_t>(p[1]) << 16) |
+         (static_cast<uint32_t>(p[2]) << 8) | static_cast<uint32_t>(p[3]);
+}
+
+}  // namespace
+
+void Dart_SankofaSetBaseSnapshots(const uint8_t* isolate_data,
+                                  const uint8_t* isolate_instructions,
+                                  const uint8_t* vm_data,
+                                  const uint8_t* vm_instructions) {
+  FusionState* s = Fusion();
+  s->base_isolate_data = isolate_data;
+  s->base_isolate_instructions = isolate_instructions;
+  s->base_vm_data = vm_data;
+  s->base_vm_instructions = vm_instructions;
+}
+
+intptr_t Dart_SankofaReadLinkHeader(const void* mapping, intptr_t size) {
+  if (mapping == nullptr || size < 4) return -1;
+  const uint8_t* p = static_cast<const uint8_t*>(mapping);
+  const uint32_t count = ReadU32BE(p);
+  // count + (sim,cpu) pairs. Use 64-bit math so a hostile count can't
+  // overflow the bounds check.
+  const int64_t table_bytes = 4 + static_cast<int64_t>(count) * 8;
+  if (table_bytes > size) return -1;  // truncated / hostile count
+
+  FusionState* s = Fusion();
+  s->link.clear();
+  s->link.reserve(count);
+  s->cpu_sorted.clear();
+  s->cpu_sorted.reserve(count);
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint8_t* e = p + 4 + static_cast<int64_t>(i) * 8;
+    const intptr_t sim = static_cast<intptr_t>(ReadU32BE(e));
+    const intptr_t cpu = static_cast<intptr_t>(ReadU32BE(e + 4));
+    s->link[sim] = cpu;
+    s->cpu_sorted.emplace_back(cpu, sim);
+  }
+  // Sort by cpu (base) offset so the reverse PC lookup can range-search.
+  std::sort(s->cpu_sorted.begin(), s->cpu_sorted.end());
+  // 16384-align (matches LinkTable.toBytes padToAlignment=16384): the embedded
+  // ELF begins on the next 16 KB boundary. iOS arm64 uses 16 KB pages and
+  // Dart_LoadELF mmaps the ELF at this offset, so a 4 KB-only alignment fails
+  // with "File offset must be page-aligned" on device.
+  const int64_t aligned = (table_bytes + 16383) & ~static_cast<int64_t>(16383);
+  if (aligned > size) return -1;  // padding runs past the buffer
+  return static_cast<intptr_t>(aligned);
