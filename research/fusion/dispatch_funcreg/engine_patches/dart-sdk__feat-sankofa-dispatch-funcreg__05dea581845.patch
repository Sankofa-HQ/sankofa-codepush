+    const char* dot = strchr(c, '.');
+    if (dot == nullptr) {
+      return lib.LookupFunctionAllowPrivate(qname);
+    }
+    const intptr_t split = static_cast<intptr_t>(dot - c);
+    const String& cls_name =
