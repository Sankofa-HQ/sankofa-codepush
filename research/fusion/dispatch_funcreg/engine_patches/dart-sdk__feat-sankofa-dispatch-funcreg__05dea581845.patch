diff --git a/runtime/bin/gen_snapshot.cc b/runtime/bin/gen_snapshot.cc
index 43480d22bda..c70995ff7da 100644
--- a/runtime/bin/gen_snapshot.cc
+++ b/runtime/bin/gen_snapshot.cc
@@ -694,6 +694,45 @@ static void CreateAndWritePrecompiledSnapshot() {
   ASSERT(kind_str != nullptr);
   ASSERT(filename != nullptr);
 
+  // Sankofa CodePush — HYBRID SNAPSHOT (build-time bytecode emission). BEFORE
+  // precompile, MERGE-load a dart2bytecode component (built no-prefix, same
+  // library uris as the base) so its functions' bytecode attaches to the
+  // EXISTING base functions (is_declared_in_bytecode + Code=InterpretCall stub).
+  // Done pre-precompile so the precompiler treats them as bytecode functions and
+  // the finalized tables reflect it (a post-precompile transplant is ignored by
+  // the AOT serializer — verified). Precompiler::CompileFunction skips
+  // is_declared_in_bytecode functions, so they ship as interpreted code and the
+  // rest AOT-compile. Env-gated bring-up: SANKOFA_GENSNAP_PATCH=<component>.
+  if (const char* patch_path = getenv("SANKOFA_GENSNAP_PATCH")) {
+    Dart_EnterScope();
+    File* pf = File::Open(nullptr, patch_path, File::kRead);
+    if (pf == nullptr) {
+      Syslog::PrintErr("[sankofa-gensnap] cannot open %s\n", patch_path);
+    } else {
+      intptr_t plen = static_cast<intptr_t>(pf->Length());
+      uint8_t* pbuf = reinterpret_cast<uint8_t*>(malloc(plen));
+      pf->SetPosition(0);
+      pf->ReadFully(pbuf, plen);
+      pf->Release();
+      Dart_Handle td =
+          Dart_NewExternalTypedData(Dart_TypedData_kUint8, pbuf, plen);
+      dart::snapshot_analyzer::Dart_SankofaSetBytecodeMerge(true);
+      Dart_Handle plib = Dart_LoadLibraryFromBytecode(td);
+      dart::snapshot_analyzer::Dart_SankofaSetBytecodeMerge(false);
+      if (Dart_IsError(plib)) {
+        Syslog::PrintErr("[sankofa-gensnap] merge-load bytecode: %s\n",
+                         Dart_GetError(plib));
+      } else {
+        // NOTE: no Dart_FinalizeLoading here — the base classes are already
+        // finalized and re-finalizing them re-creates the merged functions
+        // (dropping the attached bytecode). Precompile finalizes anyway.
+        Syslog::PrintErr(
+            "[sankofa-gensnap] merge-loaded bytecode onto base program OK\n");
+      }
+    }
+    Dart_ExitScope();
+  }
+
   // Precompile with specified embedder entry points
   Dart_Handle result = Dart_Precompile();
   CHECK_RESULT(result);
