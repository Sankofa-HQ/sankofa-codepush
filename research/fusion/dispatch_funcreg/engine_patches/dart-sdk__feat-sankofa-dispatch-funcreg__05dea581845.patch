+// ── Sankofa code-push: dispatch-table reroute (apply path) ───────────────
+// Resolve "function" (toplevel) or "Class.method" in |lib|. Mirrors the
+// resolver in Dart_SankofaTransplantBytecode.
+static FunctionPtr ResolveSankofaFn(Thread* thread,
+                                    const Library& lib,
+                                    const char* c) {
+  Zone* zone = thread->zone();
+  const String& qname = String::Handle(zone, String::New(c));
+  const char* dot = strchr(c, '.');
+  if (dot == nullptr) {
+    return lib.LookupFunctionAllowPrivate(qname);
+  }
+  const intptr_t split = static_cast<intptr_t>(dot - c);
+  const String& cls_name =
+      String::Handle(zone, String::SubString(qname, 0, split));
+  const String& m_name =
+      String::Handle(zone, String::SubString(qname, split + 1));
+  const Class& cls = Class::Handle(zone, lib.LookupClassAllowPrivate(cls_name));
+  if (cls.IsNull()) return Function::null();
+  cls.EnsureIsFinalized(thread);
+  return cls.LookupFunctionAllowPrivate(m_name);
+}
+
+// Returns the current code entry-point of |name| in |library| (0 on error).
+// Capture this BEFORE transplanting a function to bytecode: a virtual method's
+// dispatch-table slots hold this entry, and Dart_SankofaRepointDispatchToInterpret
+// scans for it to reroute them.
+uintptr_t Dart_SankofaCodeEntryForName(const char* name) {
+  Thread* thread = Thread::Current();
+  if (thread == nullptr || name == nullptr) return 0;
+  DARTSCOPE(thread);
+  const Library& lib = Library::Handle(
+      thread->zone(), thread->isolate_group()->object_store()->root_library());
+  if (lib.IsNull()) return 0;
+  const Function& fn =
+      Function::Handle(thread->zone(), ResolveSankofaFn(thread, lib, name));
+  if (fn.IsNull() || !fn.HasCode()) return 0;
+  return static_cast<uintptr_t>(Code::EntryPointOf(fn.CurrentCode()));
+}
+
+// After |name| has been transplanted to bytecode, reroute every dispatch-table
+// slot that held |old_entry| (its pre-transplant code entry) to the
+// SankofaDispatchInterpret trampoline, and set the slot's function-half to the
+// (now bytecode) Function so the trampoline can load FUNCTION_REG. This makes an
+// UNCHANGED base-AOT dispatch-table call (e.g. framework -> build()) reach the
+// interpreted body with no flag, no JIT. Returns slots repointed, or -1.
+intptr_t Dart_SankofaRepointDispatchToInterpret(const char* name,
+                                                uintptr_t old_entry) {
+  Thread* thread = Thread::Current();
+  if (thread == nullptr || name == nullptr || old_entry == 0) return -1;
+  DARTSCOPE(thread);
+  const Library& lib = Library::Handle(
+      thread->zone(), thread->isolate_group()->object_store()->root_library());
+  if (lib.IsNull()) return -1;
+  const Function& fn =
+      Function::Handle(thread->zone(), ResolveSankofaFn(thread, lib, name));
+  if (fn.IsNull()) return -1;
+  DispatchTable* dt = thread->isolate_group()->dispatch_table();
+  if (dt == nullptr) return -1;
+  const uword trampoline = StubCode::SankofaDispatchInterpret().EntryPoint();
+  uword* arr = dt->mutable_array();
+  const intptr_t len = dt->length();
+  const uword fn_ptr = static_cast<uword>(fn.ptr());
+  const uword want = static_cast<uword>(old_entry);
+  intptr_t repointed = 0;
+  for (intptr_t i = 0; i < len; i++) {
+    const intptr_t e = DispatchTable::kSlotStride * i;
+    if (arr[e] == want) {
+      arr[e] = trampoline;
+      arr[e + 1] = fn_ptr;
+      repointed++;
+    }
+  }
+  return repointed;
+}
