+const uint8_t* Dart_SankofaBaseIsolateData() {
+  return Fusion()->base_isolate_data;
+}
+const uint8_t* Dart_SankofaBaseIsolateInstructions() {
+  return Fusion()->base_isolate_instructions;
+}
+const uint8_t* Dart_SankofaBaseVmData() {
+  return Fusion()->base_vm_data;
+}
+const uint8_t* Dart_SankofaBaseVmInstructions() {
+  return Fusion()->base_vm_instructions;
+}
