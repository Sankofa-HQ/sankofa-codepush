+  // The manifest rides inside the patch: _sankofaManifest() -> a comma-separated
+  // STRING of "target" or "target=source" pairs (a String, NOT a List, so the
+  // patch carries no _GrowableList — which a slim AOT base tree-shakes out).
+  // For each: transplant base root_library[target] <- patch plib[source] and
+  // repoint target's dispatch-table slots. The SOURCE is typically a TOP-LEVEL
+  // patch fn (no class -> no Object. ctor) so the bytecode references zero
+  // base-SDK callables and loads against any slim AOT app; the TARGET is the
+  // app's (possibly virtual) method.
   Dart_Handle manifest = Dart_Invoke(
       plib, Dart_NewStringFromCString("_sankofaManifest"), 0, nullptr);
-  if (tonic::CheckAndHandleError(manifest) || !Dart_IsList(manifest)) {
-    FML_LOG(ERROR) << "[sankofa] patch manifest (_sankofaManifest) missing";
+  if (tonic::CheckAndHandleError(manifest) || !Dart_IsString(manifest)) {
+    FML_LOG(ERROR) << "[sankofa] patch manifest (_sankofaManifest String) "
+                      "missing";
     return;
   }
-  intptr_t len = 0;
-  if (tonic::CheckAndHandleError(Dart_ListLength(manifest, &len))) {
-    return;
-  }
-  int ok = 0, fail = 0;
-  for (intptr_t i = 0; i < len; i++) {
-    Dart_Handle entry = Dart_ListGetAt(manifest, i);
-    if (Dart_IsError(entry) || !Dart_IsString(entry)) {
-      fail++;
-      continue;
+  const char* manifest_cstr = nullptr;
+  Dart_StringToCString(manifest, &manifest_cstr);
+  int ok = 0, fail = 0, repointed_total = 0;
+  char* names = ::strdup(manifest_cstr);
+  for (char* tok = ::strtok(names, ","); tok != nullptr;
+       tok = ::strtok(nullptr, ",")) {
+    // "target=source", or "name" for same-name transplant.
+    char* target = tok;
+    const char* source = tok;
+    char* eq = ::strchr(tok, '=');
+    if (eq != nullptr) {
+      *eq = '\0';
+      source = eq + 1;
     }
-    const char* name = nullptr;
-    Dart_StringToCString(entry, &name);
-    Dart_Handle nh = Dart_NewStringFromCString(name);
-    Dart_Handle tr =
-        Dart_SankofaTransplantBytecode(root_library, nh, plib, nh);
+    // Sankofa dispatch-funcreg: capture the target's current code entry BEFORE
+    // transplant. A virtual method's dispatch-table slots hold this entry.
+    uintptr_t old_entry =
+        dart::snapshot_analyzer::Dart_SankofaCodeEntryForName(target);
+    Dart_Handle tr = Dart_SankofaTransplantBytecode(
+        root_library, Dart_NewStringFromCString(target), plib,
+        Dart_NewStringFromCString(source));
     if (Dart_IsError(tr)) {
-      FML_LOG(ERROR) << "[sankofa] transplant " << name << ": "
-                     << Dart_GetError(tr);
+      FML_LOG(ERROR) << "[sankofa] transplant " << target << "<-" << source
+                     << ": " << Dart_GetError(tr);
       fail++;
     } else {
       ok++;
+      // Reroute target's dispatch-table slots to the SankofaDispatchInterpret
+      // trampoline, so an UNCHANGED base-AOT virtual call (e.g. Flutter
+      // framework -> your build()) reaches the patched interpreted body. No-op
+      // (0 slots) for non-virtual/top-level targets. No flag, no JIT.
+      if (old_entry != 0) {
+        intptr_t np =
+            dart::snapshot_analyzer::Dart_SankofaRepointDispatchToInterpret(
+                target, old_entry);
+        if (np > 0) {
+          repointed_total += static_cast<int>(np);
+          FML_LOG(INFO) << "[sankofa] dispatch repoint " << target << ": " << np
+                        << " slot(s)";
+        }
+      }
     }
   }
+  ::free(names);
   FML_LOG(INFO) << "[sankofa] boot code-push applied: " << ok
                 << " transplanted, " << fail << " failed";
+
+  // Optional post-apply self-verification: if the root library defines a
+  // top-level `sankofaVerify()`, invoke it FRESH now (before main). Because we
+  // invoke it via Dart_Invoke after transplant, the call — and every static
+  // call it makes into the cascade of transplanted functions — dispatches
+  // through the interpreter to the PATCHED bodies (no JIT). Its String result
+  // is logged so a crash-fix is observable on-device. A throw here means the
+  // patch did not take; it is logged but does not block boot.
+  std::string verify_result;
+  if (ok > 0) {
+    Dart_Handle vr =
+        Dart_Invoke(root_library,
+                    Dart_NewStringFromCString("sankofaVerify"), 0, nullptr);
+    if (Dart_IsError(vr)) {
+      // Likely "method not found" (no verify hook) — benign — or a genuine
+      // post-apply throw. Log either way.
+      verify_result = std::string("ERROR: ") + Dart_GetError(vr);
+      FML_LOG(INFO) << "[sankofa] verify: " << Dart_GetError(vr);
+    } else if (Dart_IsString(vr)) {
+      const char* vs = nullptr;
+      Dart_StringToCString(vr, &vs);
+      verify_result = vs ? vs : "(null)";
+      FML_LOG(INFO) << "[sankofa] verify => " << verify_result;
+    }
+  }
+
+  // Write a transport-resilient result file next to the patch so the outcome
+  // is observable without a live log stream (pull via the app data container).
+  {
+    const std::string& p = *g_sankofa_boot_patch_path;
+    auto slash = p.find_last_of('/');
+    if (slash != std::string::npos) {
+      std::string out_path = p.substr(0, slash) + "/sankofa_boot_result.txt";
+      if (FILE* f = ::fopen(out_path.c_str(), "w")) {
+        ::fprintf(f, "transplanted=%d failed=%d repointed=%d verify=%s\n", ok,
+                  fail, repointed_total,
+                  verify_result.empty() ? "(none)" : verify_result.c_str());
+        ::fclose(f);
+      }
+    }
+  }
 #endif  // defined(DART_DYNAMIC_MODULES)
 }
 
