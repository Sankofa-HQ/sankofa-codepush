+// [sankofa] Set when the root isolate was created via the DATA-ONLY FUSION path
+// (Dart_CreateIsolateGroupWithBaseSnapshot) rather than the simple transplant
+// boot hook. In fusion mode the staged patch IS the isolate snapshot (a .vmcode
+// = LinkTable + patch AOT ELF): unchanged Codes resolve to the running base App
+// image and changed Codes to the patch image (run via the interpreter on iOS).
+// There is no bytecode module to transplant, so SankofaApplyBootPatch instead
+// records the resolver stats. This is the on-device counterpart of the
+// host-proven `analyze_snapshot --fusion_selftest` (research/fusion).
+static bool g_sankofa_fusion_active = false;
+
+// [sankofa] Append a progress marker next to the staged patch so the fusion boot
+// path is traceable even when it crashes (device log tooling is unavailable over
+// the CoreDevice transport). Pull {patchdir}/sankofa_fusion_trace.txt off-device.
+static void SankofaFusionTrace(const char* msg) {
+  if (g_sankofa_boot_patch_path == nullptr ||
+      g_sankofa_boot_patch_path->empty()) {
+    return;
+  }
+  const std::string& p = *g_sankofa_boot_patch_path;
+  auto slash = p.find_last_of('/');
+  if (slash == std::string::npos) return;
+  std::string out = p.substr(0, slash) + "/sankofa_fusion_trace.txt";
+  if (FILE* f = ::fopen(out.c_str(), "a")) {
+    ::fprintf(f, "%s\n", msg);
+    ::fclose(f);
+  }
+}
+
+// [sankofa] Detect + load a staged data-only FUSION patch (.vmcode). A .vmcode
+// is [u32 count BE][(sim,cpu)×count][pad→4096][ELF]; a transplant patch is a
+// bytecode module (no leading link table → ELF magic check fails, so it falls
+// through to the transplant hook). On a confirmed .vmcode: parse the link header
+// (populates the resolver's sim→cpu table) and Dart_LoadELF the embedded patch
+// snapshot READ-ONLY (no PROT_EXEC on iOS). Returns true + the patch isolate
+// data/instructions mappings to fuse onto the base.
+static bool SankofaTryLoadFusionPatch(const uint8_t** patch_data,
+                                      const uint8_t** patch_instr) {
+  if (g_sankofa_boot_patch_path == nullptr ||
+      g_sankofa_boot_patch_path->empty()) {
+    return false;
+  }
+  auto m = fml::FileMapping::CreateReadOnly(*g_sankofa_boot_patch_path);
+  if (m == nullptr || m->GetSize() < 8) {
+    return false;
+  }
+  const uint8_t* p = m->GetMapping();
+  const int64_t size = static_cast<int64_t>(m->GetSize());
+  // Link-table header: count (u32 BE) then count*(sim,cpu) pairs, padded to 4096.
+  const uint32_t count = (static_cast<uint32_t>(p[0]) << 24) |
+                         (static_cast<uint32_t>(p[1]) << 16) |
+                         (static_cast<uint32_t>(p[2]) << 8) |
+                         static_cast<uint32_t>(p[3]);
+  const int64_t table_bytes = 4 + static_cast<int64_t>(count) * 8;
+  if (table_bytes > size) {
+    return false;  // not a (valid) .vmcode → transplant path handles it
+  }
+  // 16384-align: matches LinkTable.toBytes padToAlignment=16384. iOS arm64 uses
+  // 16 KB pages; Dart_LoadELF mmaps the embedded ELF at this offset.
+  const int64_t elf_off = (table_bytes + 16383) & ~static_cast<int64_t>(16383);
+  if (elf_off + 4 > size) {
+    return false;
+  }
+  // ELF magic (0x7F 'E' 'L' 'F') at the padded offset confirms a fusion vmcode.
+  if (!(p[elf_off] == 0x7F && p[elf_off + 1] == 'E' && p[elf_off + 2] == 'L' &&
+        p[elf_off + 3] == 'F')) {
+    return false;
+  }
+  {
+    char b[160];
+    ::snprintf(b, sizeof(b), "1_detect count=%u elf_off=%lld size=%lld",
+               count, static_cast<long long>(elf_off),
+               static_cast<long long>(size));
+    SankofaFusionTrace(b);
+  }
+  // Confirmed fusion patch. Parse the link header into the resolver's table.
+  const intptr_t eoff = dart::snapshot_analyzer::Dart_SankofaReadLinkHeader(
+      p, static_cast<intptr_t>(size));
+  if (eoff < 0) {
+    SankofaFusionTrace("2_header FAILED");
+    FML_LOG(ERROR) << "[sankofa] fusion link header invalid";
+    return false;
+  }
+  SankofaFusionTrace("2_header ok");
+  // Load the embedded patch snapshot. READ-ONLY: on no-JIT iOS the patch's
+  // native instructions cannot be PROT_EXEC-mapped; they are never executed
+  // (unchanged → base App, changed → interpreter).
+  Dart_SankofaSetElfForceReadOnly(true);
+  const char* err = nullptr;
+  const uint8_t *pvd = nullptr, *pvi = nullptr;
+  Dart_LoadedElf* elf =
+      Dart_LoadELF(g_sankofa_boot_patch_path->c_str(),
+                   static_cast<uint64_t>(eoff), &err, &pvd, &pvi, patch_data,
+                   patch_instr);
+  Dart_SankofaSetElfForceReadOnly(false);
+  if (elf == nullptr) {
+    char b[200];
+    ::snprintf(b, sizeof(b), "3_loadelf FAILED: %s", err ? err : "(null)");
+    SankofaFusionTrace(b);
+    FML_LOG(ERROR) << "[sankofa] fusion patch ELF load failed: "
+                   << (err ? err : "(null)");
+    return false;
+  }
+  g_sankofa_fusion_active = true;
+  SankofaFusionTrace("3_loadelf ok -> calling CreateIsolateGroupWithBaseSnapshot");
+  FML_LOG(INFO) << "[sankofa] fusion patch loaded: link_count=" << count
+                << " elf_offset=" << eoff;
+  return true;
+}
