+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/common/sankofa/sankofa.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#include "flutter/fml/logging.h"
+#include "flutter/runtime/dart_isolate.h"
+#include "flutter/shell/common/sankofa/updater.h"
+
+namespace flutter {
+namespace sankofa {
+
+namespace {
+
+// In-memory seekable file backing for the updater's FileCallbacks. The Rust
+// updater accesses scratch/diff data through these callbacks (open -> handle;
+// read/seek over it; close). A plain growable byte buffer satisfies the
+// CFileProvider (Read + Seek) contract.
+// NOTE(sankofa): for the bytecode-transplant patch model the patch is a whole
+// self-contained module (not a bidiff against libapp), so this path is lightly
+// exercised; validate on the first on-device round-trip.
+struct MemFile {
+  std::vector<uint8_t> data;
+  size_t pos = 0;
+};
+
+void* MemOpen(void) {
+  return new MemFile();
+}
+
+uintptr_t MemRead(void* handle, uint8_t* buffer, uintptr_t count) {
+  auto* f = static_cast<MemFile*>(handle);
+  if (f == nullptr || f->pos >= f->data.size()) {
+    return 0;
+  }
+  size_t avail = f->data.size() - f->pos;
+  size_t n = count < avail ? count : avail;
+  std::memcpy(buffer, f->data.data() + f->pos, n);
+  f->pos += n;
+  return n;
+}
+
+int64_t MemSeek(void* handle, int64_t offset, int32_t whence) {
+  auto* f = static_cast<MemFile*>(handle);
+  if (f == nullptr) {
+    return -1;
+  }
+  int64_t base = 0;
+  if (whence == SEEK_SET) {
+    base = 0;
+  } else if (whence == SEEK_CUR) {
+    base = static_cast<int64_t>(f->pos);
+  } else {  // SEEK_END
+    base = static_cast<int64_t>(f->data.size());
+  }
+  int64_t target = base + offset;
+  if (target < 0) {
+    target = 0;
+  }
+  f->pos = static_cast<size_t>(target);
+  return target;
+}
+
+void MemClose(void* handle) {
+  delete static_cast<MemFile*>(handle);
+}
+
+FileCallbacks InMemoryFileCallbacks() {
+  FileCallbacks cb;
+  cb.open = MemOpen;
+  cb.read = MemRead;
+  cb.seek = MemSeek;
+  cb.close = MemClose;
+  return cb;
+}
+
+}  // namespace
+
+void ConfigureSankofa(const std::string& release_version,
+                      const std::vector<std::string>& original_libapp_paths,
+                      const std::string& app_storage_dir,
+                      const std::string& code_cache_dir,
+                      const std::string& yaml_config) {
+  AppConfig config;
+  config.release_version = release_version;
+  config.original_libapp_paths = original_libapp_paths;
+  config.app_storage_dir = app_storage_dir;
+  config.code_cache_dir = code_cache_dir;
+  config.file_callbacks = InMemoryFileCallbacks();
+  config.yaml_config = yaml_config;
+
+  Updater& updater = Updater::Instance();
+  if (!updater.Init(config)) {
+    FML_LOG(ERROR) << "[sankofa] updater init failed; booting base release";
+    return;
+  }
+
+  // Integrity-check the staged patch; falls back to last-good/base if invalid.
+  updater.ValidateNextBootPatch();
+
+  const std::string patch_path = updater.NextBootPatchPath();
+  if (!patch_path.empty()) {
+    // Mark that we're booting from this patch (grace-window opens; if the boot
+    // crashes and ReportLaunchSuccess is never called, the updater rolls back).
+    updater.ReportLaunchStart();
+    DartIsolate::SetSankofaBootPatchPath(patch_path);
+    FML_LOG(INFO) << "[sankofa] boot patch selected: " << patch_path;
+  }
+
+  // Kick off a background download of the next update, if configured.
+  if (updater.ShouldAutoUpdate()) {
+    updater.StartUpdateThread();
+  }
+}
+
+void ReportLaunchSuccess() {
+  Updater::Instance().ReportLaunchSuccess();
+}
+
+}  // namespace sankofa
+}  // namespace flutter
