From 08d95c43a8f5e7461af0b0e4eca9d518c9dc00da Mon Sep 17 00:00:00 2001
From: saytoonz <35128520+saytoonz@users.noreply.github.com>
Date: Fri, 26 Jun 2026 16:19:08 +0000
Subject: [PATCH 1/8] =?UTF-8?q?runtime:=20SankofaApplyBootPatch=20?=
 =?UTF-8?q?=E2=80=94=20on-device=20code-push=20apply=20at=20boot=20(no=20J?=
 =?UTF-8?q?IT)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

DartIsolate::SankofaApplyBootPatch(root_library), called from RunFromLibrary
before InvokeMainEntrypoint (isolate ready, main not yet run -> call sites fresh,
no IC flush). If SANKOFA_PATCH_DIR has sankofa_patch.{bytecode,names}, it
Dart_LoadLibraryFromBytecode the module and Dart_SankofaTransplantBytecode each
named fn onto the base app fn -> new body runs via the interpreter, no JIT. This
is the on-device counterpart of the host-proven analyze_snapshot
--bytecode_patch --patch_fns apply. Missing/empty patch boots normally; failures
log and never abort boot. No fusion plumbing needed (transplant onto the app's
own isolate). Compile-verified (dart_isolate.o builds clean).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 engine/src/flutter/runtime/dart_isolate.cc | 87 ++++++++++++++++++++++
 1 file changed, 87 insertions(+)

diff --git a/engine/src/flutter/runtime/dart_isolate.cc b/engine/src/flutter/runtime/dart_isolate.cc
index 521c284f1c9..31a5f745f93 100644
--- a/engine/src/flutter/runtime/dart_isolate.cc
+++ b/engine/src/flutter/runtime/dart_isolate.cc
@@ -8,6 +8,7 @@
 #include <utility>
 
 #include "flutter/fml/logging.h"
+#include "flutter/fml/mapping.h"
 #include "flutter/fml/posix_wrappers.h"
 #include "flutter/fml/trace_event.h"
 #include "flutter/lib/io/dart_io.h"
@@ -906,6 +907,88 @@ bool DartIsolate::MarkIsolateRunnable() {
   return true;
 }
 
+// [sankofa] Boot-time code-push apply. Before main() runs, if a staged patch is
+// present (SANKOFA_PATCH_DIR/sankofa_patch.{bytecode,names}), load its bytecode
+// module and AttachBytecode each named function onto the base app function. The
+// function's Code becomes the InterpretCall stub, so the new body runs through
+// the interpreter (dart::Interpreter::Run) with NO JIT — App-Store legal. This
+// is the on-device counterpart of the host-proven analyze_snapshot
+// --bytecode_patch --patch_fns apply (research/fusion/override_in_place +
+// cli_v0). Rerouting of existing callers is covered by: re-shipped callers in
+// the cascade (also bytecode, interpreter-dispatched) and, for unchanged
+// base-AOT instance calls, the switchable-IC + monomorphic-skip path in a base
+// engine built with SANKOFA_NO_TABLE_DISPATCH. Boot-time apply (before main)
+// means call sites are fresh, so no IC flush is needed. Failures are logged and
+// never abort boot.
+static void SankofaApplyBootPatch(Dart_Handle root_library) {
+#if defined(DART_DYNAMIC_MODULES)
+  const char* dir = ::getenv("SANKOFA_PATCH_DIR");
+  if (dir == nullptr || dir[0] == '\0') {
+    return;
+  }
+  const std::string base = std::string(dir);
+  auto bc = fml::FileMapping::CreateReadOnly(base + "/sankofa_patch.bytecode");
+  auto nm = fml::FileMapping::CreateReadOnly(base + "/sankofa_patch.names");
+  if (bc == nullptr || bc->GetSize() == 0 || nm == nullptr ||
+      nm->GetSize() == 0) {
+    return;  // No staged patch (or empty) — boot normally.
+  }
+
+  Dart_Handle td = Dart_NewExternalTypedData(
+      Dart_TypedData_kUint8, const_cast<uint8_t*>(bc->GetMapping()),
+      static_cast<intptr_t>(bc->GetSize()));
+  if (tonic::CheckAndHandleError(td)) {
+    FML_LOG(ERROR) << "[sankofa] patch typed-data failed";
+    return;
+  }
+  Dart_Handle plib = Dart_LoadLibraryFromBytecode(td);
+  if (tonic::CheckAndHandleError(plib)) {
+    FML_LOG(ERROR) << "[sankofa] patch bytecode load failed";
+    return;
+  }
+  if (tonic::CheckAndHandleError(Dart_FinalizeLoading(false))) {
+    FML_LOG(ERROR) << "[sankofa] patch finalize failed";
+    return;
+  }
+
+  // Manifest = comma/newline-separated function names (the CLI diff's app-scoped
+  // changed set). Transplant each: base root_library[name] <- patch plib[name].
+  std::string names(reinterpret_cast<const char*>(nm->GetMapping()),
+                    nm->GetSize());
+  int ok = 0, fail = 0;
+  size_t i = 0;
+  while (i < names.size()) {
+    size_t j = names.find_first_of(",\n\r", i);
+    if (j == std::string::npos) {
+      j = names.size();
+    }
+    std::string name = names.substr(i, j - i);
+    size_t s = name.find_first_not_of(" \t");
+    size_t e = name.find_last_not_of(" \t");
+    if (s != std::string::npos) {
+      name = name.substr(s, e - s + 1);
+    } else {
+      name.clear();
+    }
+    if (!name.empty()) {
+      Dart_Handle nh = Dart_NewStringFromCString(name.c_str());
+      Dart_Handle tr =
+          Dart_SankofaTransplantBytecode(root_library, nh, plib, nh);
+      if (Dart_IsError(tr)) {
+        FML_LOG(ERROR) << "[sankofa] transplant " << name << ": "
+                       << Dart_GetError(tr);
+        fail++;
+      } else {
+        ok++;
+      }
+    }
+    i = j + 1;
+  }
+  FML_LOG(INFO) << "[sankofa] boot code-push applied: " << ok
+                << " transplanted, " << fail << " failed";
+#endif  // defined(DART_DYNAMIC_MODULES)
+}
+
 bool DartIsolate::RunFromLibrary(std::optional<std::string> library_name,
                                  std::optional<std::string> entrypoint,
                                  const std::vector<std::string>& args) {
@@ -931,6 +1014,10 @@ bool DartIsolate::RunFromLibrary(std::optional<std::string> library_name,
     InvokeDartPluginRegistrantIfAvailable(library_handle);
   }
 
+  // [sankofa] Apply any staged code-push patch before resolving/invoking main,
+  // so existing call sites are fresh when they first run the patched bodies.
+  SankofaApplyBootPatch(library_handle);
+
   auto user_entrypoint_function =
       ::Dart_GetField(library_handle, entrypoint_handle);
 
-- 
