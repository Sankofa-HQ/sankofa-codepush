From 393eccfc374ac56788378bc802f24d620a372701 Mon Sep 17 00:00:00 2001
From: Sankofa <dev@sankofa.dev>
Date: Tue, 30 Jun 2026 15:53:24 +0000
Subject: [PATCH 8/8] boot hook: retain patch mapping for isolate lifetime
 (fixes live-render reroute)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The transplanted bytecode's instructions_ point INTO the patch FileMapping, but
`bc` was a local unique_ptr unmapped when SankofaApplyBootPatch returned. The
boot-context self-verify worked (mapping still alive); the live Flutter render
ran build() AFTER return -> instructions dangled -> interpreter Trapped on zeroed
memory (op=0, pc_off=0, in_range=1).

Fix: hand the mapping's ownership to the ExternalTypedData via
Dart_NewExternalTypedDataWithFinalizer. The typed data is retained by the
Bytecode -> Function for the isolate group's lifetime, so the buffer is unmapped
only at isolate shutdown — no leak, no use-after-free.

PROVEN on iPhone 14 Pro: live panelStatus() inside build() => render->
PATCH-UI-FIXED-V2-LIVE (downloaded 790B bytecode, live render, no JIT, no crash).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 engine/src/flutter/runtime/dart_isolate.cc | 29 +++++++++++++++++++---
 1 file changed, 25 insertions(+), 4 deletions(-)

diff --git a/engine/src/flutter/runtime/dart_isolate.cc b/engine/src/flutter/runtime/dart_isolate.cc
index 309b78103fb..b73ce47d526 100644
--- a/engine/src/flutter/runtime/dart_isolate.cc
+++ b/engine/src/flutter/runtime/dart_isolate.cc
@@ -1084,6 +1084,19 @@ static bool SankofaTryLoadFusionPatch(const uint8_t** patch_data,
 // SANKOFA_NO_TABLE_DISPATCH). Boot-time apply = call sites fresh, no IC flush.
 // The patch is ONE self-contained file (manifest embedded); the updater handles
 // download/Ed25519-verify/version-select/rollback. Failures log + never abort.
+// [sankofa] The transplanted bytecode's instructions_ point INTO the patch
+// file mapping (an external, GC-non-movable buffer). That mapping IS the live
+// body of every transplanted function for the isolate group's lifetime, so it
+// must outlive the boot hook. Ownership is handed to the ExternalTypedData via
+// this finalizer: the buffer is unmapped only when that typed data (retained by
+// the Bytecode -> Function) is GC'd at isolate shutdown — no leak, no dangling.
+// (Previously `bc` was a local unique_ptr unmapped on return, so instructions_
+// dangled and the live render Trapped: op=0 at pc_off=0, in_range=1.)
+static void SankofaPatchMappingFinalizer(void* /*isolate_callback_data*/,
+                                         void* peer) {
+  delete static_cast<fml::FileMapping*>(peer);
+}
+
 static void SankofaApplyBootPatch(Dart_Handle root_library) {
 #if defined(DART_DYNAMIC_MODULES)
   // [sankofa] Data-only FUSION boot: the patch was already fused at isolate
@@ -1120,12 +1133,20 @@ static void SankofaApplyBootPatch(Dart_Handle root_library) {
   if (bc == nullptr || bc->GetSize() == 0) {
     return;
   }
-
-  Dart_Handle td = Dart_NewExternalTypedData(
-      Dart_TypedData_kUint8, const_cast<uint8_t*>(bc->GetMapping()),
-      static_cast<intptr_t>(bc->GetSize()));
+  const intptr_t patch_size = static_cast<intptr_t>(bc->GetSize());
+
+  // Hand the mapping's ownership to the ExternalTypedData so it outlives this
+  // function: the transplanted bytecode's instructions_ point into this buffer
+  // and must stay mapped for the isolate group's lifetime (see the finalizer
+  // note above). Without this the buffer was munmap'd on return and the live
+  // render-path dispatch Trapped on zeroed instruction memory.
+  fml::FileMapping* patch_map = bc.release();
+  Dart_Handle td = Dart_NewExternalTypedDataWithFinalizer(
+      Dart_TypedData_kUint8, const_cast<uint8_t*>(patch_map->GetMapping()),
+      patch_size, patch_map, patch_size, &SankofaPatchMappingFinalizer);
   if (tonic::CheckAndHandleError(td)) {
     FML_LOG(ERROR) << "[sankofa] patch typed-data failed";
+    delete patch_map;  // typed-data creation failed — ownership not transferred
     return;
   }
   Dart_Handle plib = Dart_LoadLibraryFromBytecode(td);
