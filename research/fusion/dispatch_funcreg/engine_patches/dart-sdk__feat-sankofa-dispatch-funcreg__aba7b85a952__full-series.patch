+    js.PrintProperty64(
+        "instance_size_in_words",
+        cls.host_instance_size() / compiler::target::kWordSize);
+    js.PrintProperty64("num_type_arguments", cls.NumTypeArguments());
+    js.PrintPropertyBool("is_abstract", cls.is_abstract());
+    js.PrintPropertyBool("is_top_level", cls.IsTopLevel());
+    js.PrintPropertyBool("is_const", cls.is_const());
