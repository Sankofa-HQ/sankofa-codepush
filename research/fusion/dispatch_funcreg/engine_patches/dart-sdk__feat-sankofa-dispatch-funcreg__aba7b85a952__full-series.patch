+intptr_t Dart_SankofaLookupCpuOffset(intptr_t sim_offset) {
+  const FusionState* s = Fusion();
+  auto it = s->link.find(sim_offset);
+  return it == s->link.end() ? -1 : it->second;
+}
+
+uintptr_t Dart_SankofaResolveEntryPoint(uintptr_t patch_image_start,
+                                        uintptr_t pc_offset) {
+  FusionState* s = Fusion();  // non-const: bumps the diagnostic counters
+  // No patch loaded (base-only isolate): the link table is empty, so this is
+  // a zero-overhead passthrough — the normal single-image entry point.
+  if (s->link.empty()) {
+    return patch_image_start + pc_offset;
+  }
+  // Patch isolate: a Code whose offset is in the link table is UNCHANGED —
+  // resolve it to the base App's executable instructions (cpu offset). A Code
+  // NOT in the table is CHANGED — keep it in the patch image (on iOS that page
+  // is kReadOnly → the interpreter handoff runs it; on mac the patch image is
+  // executable so it runs directly, which makes the fusion locally validatable).
+  auto it = s->link.find(static_cast<intptr_t>(pc_offset));
+  if (it != s->link.end() && s->base_isolate_instructions != nullptr) {
+    s->resolve_base_hits++;
+    return reinterpret_cast<uintptr_t>(s->base_isolate_instructions) +
+           static_cast<uintptr_t>(it->second);
+  }
+  s->resolve_patch_hits++;
+  return patch_image_start + pc_offset;
+}
+
+uintptr_t Dart_SankofaBasePcToPatchPc(uintptr_t patch_image_start,
+                                      uintptr_t pc) {
+  FusionState* s = Fusion();
+  if (s->link.empty() || s->base_isolate_instructions == nullptr) return 0;
+  const uintptr_t base_start =
+      reinterpret_cast<uintptr_t>(s->base_isolate_instructions);
+  if (getenv("SANKOFA_REVTRACE") != nullptr) {
+    static int n = 0;
+    if (n++ < 8) {
+      ::fprintf(stderr,
+                "[revfuse] pc=%p base_start=%p patch_start=%p in_base=%d\n",
+                reinterpret_cast<void*>(pc), reinterpret_cast<void*>(base_start),
+                reinterpret_cast<void*>(patch_image_start), pc >= base_start);
+      ::fflush(stderr);
+    }
+  }
+  if (pc < base_start) return 0;  // below the base image — not a base PC
+  const intptr_t base_offset = static_cast<intptr_t>(pc - base_start);
+  // Largest cpu (base) offset <= base_offset = the base Code containing this PC.
+  auto it = std::upper_bound(
+      s->cpu_sorted.begin(), s->cpu_sorted.end(),
+      std::make_pair(base_offset, INTPTR_MAX));
+  if (it == s->cpu_sorted.begin()) return 0;  // before the first base Code
+  --it;
+  const intptr_t cpu = it->first;
+  const intptr_t sim = it->second;
+  const intptr_t delta = base_offset - cpu;
+  auto next = it + 1;
+  if (next != s->cpu_sorted.end() && delta >= (next->first - cpu)) {
+    return 0;  // past this Code's extent (gap) — let the caller treat as patch
+  }
+  // Equivalent PC inside the patch image (where the InstructionsTable lives).
+  return patch_image_start + static_cast<uintptr_t>(sim + delta);
+}
+
+void Dart_SankofaResolverStats(intptr_t* base_hits, intptr_t* patch_hits) {
+  const FusionState* s = Fusion();
+  if (base_hits != nullptr) *base_hits = s->resolve_base_hits;
+  if (patch_hits != nullptr) *patch_hits = s->resolve_patch_hits;
+}
+
+// Hybrid-snapshot merge-mode toggle (build-time, process-global single-writer —
+// gen_snapshot serialises its load). Read by BytecodeLoader::LoadBytecode.
+static bool g_sankofa_bytecode_merge = false;
+void Dart_SankofaSetBytecodeMerge(bool enabled) {
+  g_sankofa_bytecode_merge = enabled;
+}
+bool Dart_SankofaBytecodeMerge() {
+  return g_sankofa_bytecode_merge;
+}
+
 }  // namespace snapshot_analyzer
 }  // namespace dart
