+//     "snapshot_data": {
+//       "vm_data_length": "<num as decimal string>",
+//       "adjusted_vm_instructions_length": "<num as decimal string>",
+//       "vm_data_hash": "<num as decimal string>",
+//       "adjusted_vm_instructions_hash": "<num as decimal string>",
+//       "dart_version": "<string?>",
+//       "snapshot_version": "<string?>"
+//     },
