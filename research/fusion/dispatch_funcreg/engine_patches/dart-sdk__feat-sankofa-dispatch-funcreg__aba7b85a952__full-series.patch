+// =====================================================================
+// Field-table link data
+//
+// Binary file layout (little-endian throughout):
+//
+//   magic          : 4 bytes ASCII "SFTL"
+//   version        : uint32 = 1
+//   num_classes    : uint32       (only classes with >=1 field counted)
+//   name_blob_size : uint32
+//   class_entries  : variable
+//   name_blob      : packed UTF-8 strings
+//
+//   ClassEntry =
+//     cid          : uint32
+//     num_fields   : uint32
+//     fields       : num_fields * FieldEntry
+//
+//   FieldEntry =
+//     name_offset           : uint32   (into name_blob)
+//     name_length           : uint32
+//     host_offset_in_bytes  : uint32   (Field::HostOffset())
+//     flags                 : uint32   (0x1 unboxed; 0x2 final; 0x4 late;
+//                                       0x8 static; 0x10 shared)
+//
+// The Linker uses this to confirm that the patch's per-class field
+// offsets are identical to the base — so PP-relative loads of `this.x`
+// land at the same offset.
+// =====================================================================
+
+intptr_t Dart_WriteSankofaFieldTableLinkData(const char* path) {
+  if (path == nullptr) return 1;
+  Thread* thread = Thread::Current();
+  if (thread == nullptr) return 1;
+  DARTSCOPE(thread);
+  auto* class_table = thread->isolate_group()->class_table();
+  if (class_table == nullptr) return 1;
+  const intptr_t num_cids = class_table->NumCids();
+
+  Buf header;
+  header.Magic4("SFTL");
+  header.U32(1);  // version
+
+  Buf entries;
+  std::string name_blob;
+  uint32_t emitted_classes = 0;
+
+  Class& cls = Class::Handle(thread->zone());
+  Array& fields = Array::Handle(thread->zone());
+  Field& field = Field::Handle(thread->zone());
+  String& name_handle = String::Handle(thread->zone());
+
+  for (intptr_t cid = 0; cid < num_cids; cid++) {
+    if (!class_table->HasValidClassAt(cid)) continue;
+    cls = class_table->At(cid);
+    if (cls.IsNull()) continue;
+    fields = cls.fields();
+    if (fields.IsNull()) continue;
+    const intptr_t num_fields = fields.Length();
+    if (num_fields == 0) continue;
+
+    entries.U32(static_cast<uint32_t>(cid));
+    entries.U32(static_cast<uint32_t>(num_fields));
+    for (intptr_t i = 0; i < num_fields; i++) {
+      field ^= fields.At(i);
+      name_handle = field.name();
+      std::string name;
+      if (!name_handle.IsNull()) {
+        const char* cstr = name_handle.ToCString();
+        if (cstr != nullptr) name = cstr;
+      }
+      const uint32_t name_offset = static_cast<uint32_t>(name_blob.size());
+      const uint32_t name_length = static_cast<uint32_t>(name.size());
+      const uint32_t host_offset = static_cast<uint32_t>(field.HostOffset());
+      uint32_t flags = 0;
+      if (field.is_unboxed()) flags |= 0x1;
+      if (field.is_final()) flags |= 0x2;
+      if (field.is_late()) flags |= 0x4;
+      if (field.is_static()) flags |= 0x8;
+      if (field.is_shared()) flags |= 0x10;
+
+      entries.U32(name_offset);
+      entries.U32(name_length);
+      entries.U32(host_offset);
+      entries.U32(flags);
+      name_blob.append(name);
+    }
+    emitted_classes++;
+  }
+
+  header.U32(emitted_classes);
+  header.U32(static_cast<uint32_t>(name_blob.size()));
+
+  std::vector<uint8_t> file_bytes;
+  file_bytes.reserve(header.data().size() + entries.data().size() +
+                     name_blob.size());
+  file_bytes.insert(file_bytes.end(), header.data().begin(),
+                    header.data().end());
+  file_bytes.insert(file_bytes.end(), entries.data().begin(),
+                    entries.data().end());
+  file_bytes.insert(file_bytes.end(),
+                    reinterpret_cast<const uint8_t*>(name_blob.data()),
+                    reinterpret_cast<const uint8_t*>(name_blob.data() +
+                                                     name_blob.size()));
+  return WriteFileBytes(path, file_bytes.data(),
+                        static_cast<intptr_t>(file_bytes.size()));
+}
