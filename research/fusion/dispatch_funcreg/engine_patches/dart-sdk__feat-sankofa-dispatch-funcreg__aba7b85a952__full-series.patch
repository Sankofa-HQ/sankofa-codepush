+    js.OpenObject();
+    js.PrintProperty64("cid", cid);
+    name_handle = cls.Name();
+    if (!name_handle.IsNull()) {
+      js.PrintProperty("name", name_handle.ToCString());
+    }
+    library = cls.library();
+    if (!library.IsNull()) {
