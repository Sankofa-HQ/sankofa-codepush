+  js.CloseArray();
+  js.CloseObject();
+
+  char* buf = nullptr;
+  intptr_t buf_len = 0;
+  js.Steal(&buf, &buf_len);
+  intptr_t result = WriteFileBytes(path, buf, buf_len);
+  std::free(buf);
+  return result;
+}
