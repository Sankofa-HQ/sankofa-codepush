+namespace dart {
+namespace snapshot_analyzer {
+
+namespace {
+
+// Reads `path` into a heap-allocated buffer. Returns nullptr on failure.
+// Caller owns the returned buffer; free with ::free.
+uint8_t* SlurpFile(const char* path, intptr_t* out_size) {
+  if (path == nullptr || out_size == nullptr) return nullptr;
+  std::FILE* f = std::fopen(path, "rb");
+  if (f == nullptr) return nullptr;
+  std::fseek(f, 0, SEEK_END);
+  long size = std::ftell(f);
+  std::fseek(f, 0, SEEK_SET);
+  if (size <= 0) {
+    std::fclose(f);
+    return nullptr;
+  }
+  auto* buf = static_cast<uint8_t*>(::malloc(static_cast<size_t>(size)));
+  if (buf == nullptr) {
+    std::fclose(f);
+    return nullptr;
+  }
+  size_t read = std::fread(buf, 1, static_cast<size_t>(size), f);
+  std::fclose(f);
+  if (static_cast<long>(read) != size) {
+    ::free(buf);
+    return nullptr;
+  }
+  *out_size = static_cast<intptr_t>(size);
+  return buf;
+}
+
+// Little-endian uint32 reader.
+inline uint32_t ReadU32(const uint8_t* p) {
+  return static_cast<uint32_t>(p[0]) |
+         (static_cast<uint32_t>(p[1]) << 8) |
+         (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+
+inline bool MagicMatches(const uint8_t* p, const char* expect) {
+  return p[0] == static_cast<uint8_t>(expect[0]) &&
+         p[1] == static_cast<uint8_t>(expect[1]) &&
+         p[2] == static_cast<uint8_t>(expect[2]) &&
+         p[3] == static_cast<uint8_t>(expect[3]);
+}
+
+// ---------------------------------------------------------------
+// In-process link-data singletons.
+// ---------------------------------------------------------------
+
+struct ClassEntry {
+  uint32_t cid;
+  uint32_t super_cid;
+  uint32_t instance_size_in_words;
+  int32_t num_type_arguments;
+  uint32_t flags;
+  std::string name;
+  std::string library_uri;  // v2 only; empty for v1 files
+};
+
+struct FieldEntry {
+  std::string name;
+  uint32_t host_offset_in_bytes;
+  uint32_t flags;
+};
+
+struct ClassFieldEntries {
+  uint32_t cid;
+  std::vector<FieldEntry> fields;
+};
+
+struct PoolEntry {
+  uint32_t index;
+  uint32_t type_tag;
+  uint32_t cid;      // valid when type_tag==TaggedObject
+  uint64_t raw;      // valid when type_tag==Immediate*
+  std::string identity;  // valid when type_tag==TaggedObject
+};
+
+struct DispatchEntry {
+  uint32_t selector;
+  std::string name;  // empty if unresolved in base
+};
+
+class LinkData {
+ public:
+  static LinkData* Get() {
+    static LinkData* instance = new LinkData();
+    return instance;
+  }
+
+  // Class table — indexed by cid for O(1) lookup.
+  std::unordered_map<uint32_t, ClassEntry> classes;
+  // Field table — indexed by cid.
+  std::unordered_map<uint32_t, ClassFieldEntries> fields_by_cid;
+  // Object pool — indexed by pool index.
+  std::vector<PoolEntry> pool;
+  // Dispatch table — indexed by selector.
+  std::vector<DispatchEntry> dispatch;
+
+  intptr_t class_count() const { return static_cast<intptr_t>(classes.size()); }
+  intptr_t field_class_count() const {
+    return static_cast<intptr_t>(fields_by_cid.size());
+  }
+  intptr_t pool_count() const { return static_cast<intptr_t>(pool.size()); }
+  intptr_t dispatch_count() const {
+    return static_cast<intptr_t>(dispatch.size());
+  }
+
+ private:
+  LinkData() = default;
+};
+
+}  // namespace
+
+// =====================================================================
+// Class-table reader
+// =====================================================================
+intptr_t Dart_LoadSankofaClassTableLinkData(const char* path) {
+  intptr_t size = 0;
+  std::unique_ptr<uint8_t, void (*)(void*)> raw(SlurpFile(path, &size),
+                                                 ::free);
+  if (raw == nullptr) return 1;
+  const uint8_t* p = raw.get();
+  const uint8_t* end = p + size;
+  if (size < 16) return 2;  // need at least header
+  if (!MagicMatches(p, "SCTL")) return 3;
+  const uint32_t version = ReadU32(p + 4);
+  if (version != 1 && version != 2) return 4;
+  const uint32_t num_classes = ReadU32(p + 8);
+  const uint32_t name_blob_size = ReadU32(p + 12);
+  p += 16;
+  // v1: 7 uint32 entries (28 bytes). v2: 9 uint32 entries (36 bytes,
+  // adds library_uri_offset + library_uri_length).
+  const intptr_t entry_size = (version == 2) ? 36 : 28;
+  const intptr_t entries_size =
+      static_cast<intptr_t>(num_classes) * entry_size;
+  if (p + entries_size + name_blob_size > end) return 5;
+  const uint8_t* name_blob = p + entries_size;
+
+  LinkData* ld = LinkData::Get();
+  ld->classes.clear();
+  ld->classes.reserve(num_classes);
+  for (uint32_t i = 0; i < num_classes; i++) {
+    ClassEntry e;
+    e.cid = ReadU32(p + 0);
+    e.super_cid = ReadU32(p + 4);
+    e.instance_size_in_words = ReadU32(p + 8);
+    e.num_type_arguments = static_cast<int32_t>(ReadU32(p + 12));
+    const uint32_t name_offset = ReadU32(p + 16);
+    const uint32_t name_length = ReadU32(p + 20);
+    if (name_offset + name_length <= name_blob_size) {
+      e.name.assign(reinterpret_cast<const char*>(name_blob + name_offset),
+                    name_length);
+    }
+    if (version == 2) {
+      const uint32_t uri_offset = ReadU32(p + 24);
+      const uint32_t uri_length = ReadU32(p + 28);
+      if (uri_length > 0 && uri_offset + uri_length <= name_blob_size) {
+        e.library_uri.assign(
+            reinterpret_cast<const char*>(name_blob + uri_offset),
+            uri_length);
+      }
+      e.flags = ReadU32(p + 32);
+    } else {
+      e.flags = ReadU32(p + 24);
+    }
+    ld->classes.emplace(e.cid, std::move(e));
+    p += entry_size;
+  }
+  return 0;
+}
+
+intptr_t Dart_SankofaClassTableLinkCount() {
+  return LinkData::Get()->class_count();
+}
+
+// =====================================================================
+// Field-table reader
+// =====================================================================
+intptr_t Dart_LoadSankofaFieldTableLinkData(const char* path) {
+  intptr_t size = 0;
+  std::unique_ptr<uint8_t, void (*)(void*)> raw(SlurpFile(path, &size),
+                                                 ::free);
+  if (raw == nullptr) return 1;
+  const uint8_t* p = raw.get();
+  const uint8_t* end = p + size;
+  if (size < 16) return 2;
+  if (!MagicMatches(p, "SFTL")) return 3;
+  const uint32_t version = ReadU32(p + 4);
+  if (version != 1) return 4;
+  const uint32_t num_classes = ReadU32(p + 8);
+  const uint32_t name_blob_size = ReadU32(p + 12);
+  p += 16;
+
+  // Body is variable-length per class — first uint32 is the entries
+  // total size (we don't have that; we compute as we go and check we
+  // don't run off the end). The reader walks each ClassEntry by length.
+  LinkData* ld = LinkData::Get();
+  ld->fields_by_cid.clear();
+  for (uint32_t c = 0; c < num_classes; c++) {
+    if (p + 8 > end) return 5;
+    ClassFieldEntries entry;
+    entry.cid = ReadU32(p);
+    const uint32_t num_fields = ReadU32(p + 4);
+    p += 8;
+    const intptr_t field_size = 16;  // 4 * uint32
+    if (p + static_cast<intptr_t>(num_fields) * field_size > end) return 6;
+    entry.fields.reserve(num_fields);
+    for (uint32_t f = 0; f < num_fields; f++) {
+      FieldEntry fe;
+      const uint32_t name_offset = ReadU32(p + 0);
+      const uint32_t name_length = ReadU32(p + 4);
+      fe.host_offset_in_bytes = ReadU32(p + 8);
+      fe.flags = ReadU32(p + 12);
+      // Name blob comes after entries — we'll resolve once we know
+      // where it starts.
+      fe.name.assign(reinterpret_cast<const char*>(0), 0);
+      // Store the offsets in-place for second pass.
+      (void)name_offset;
+      (void)name_length;
+      // Re-encode for second pass: stash offset/length into raw.
+      fe.host_offset_in_bytes = ReadU32(p + 8);  // keep
+      // Use the upper 32 bits of `flags` field as a stash — but flags
+      // is uint32 so we don't have room. Use separate parsing pass
+      // by remembering the field span.
+      entry.fields.push_back(std::move(fe));
+      p += field_size;
+    }
+    ld->fields_by_cid.emplace(entry.cid, std::move(entry));
+  }
+  // p now points at start of name_blob.
+  const uint8_t* name_blob_start = p;
+  if (p + name_blob_size > end) return 7;
+
+  // Second pass: walk again to resolve names from name_blob. We didn't
+  // store the offset/length earlier — re-read from the file using
+  // entry_count + field positions. Compute positions deterministically:
+  // body started at raw.get() + 16 and each ClassEntry is
+  // 8 + num_fields*16 bytes. Walk in parallel with fields_by_cid.
+  const uint8_t* body = raw.get() + 16;
+  for (uint32_t c = 0; c < num_classes; c++) {
+    const uint32_t cid = ReadU32(body);
+    const uint32_t num_fields = ReadU32(body + 4);
+    body += 8;
+    auto it = ld->fields_by_cid.find(cid);
+    if (it == ld->fields_by_cid.end()) {
+      body += static_cast<intptr_t>(num_fields) * 16;
+      continue;
+    }
+    auto& flist = it->second.fields;
+    for (uint32_t f = 0; f < num_fields; f++) {
+      const uint32_t name_offset = ReadU32(body + 0);
+      const uint32_t name_length = ReadU32(body + 4);
+      if (name_offset + name_length <= name_blob_size && f < flist.size()) {
+        flist[f].name.assign(
+            reinterpret_cast<const char*>(name_blob_start + name_offset),
+            name_length);
+      }
+      body += 16;
+    }
+  }
+  return 0;
+}
+
+intptr_t Dart_SankofaFieldTableLinkCount() {
+  return LinkData::Get()->field_class_count();
+}
+
+// =====================================================================
+// Object-pool reader
+// =====================================================================
+intptr_t Dart_LoadSankofaObjectPoolLinkData(const char* path) {
+  intptr_t size = 0;
+  std::unique_ptr<uint8_t, void (*)(void*)> raw(SlurpFile(path, &size),
+                                                 ::free);
+  if (raw == nullptr) return 1;
+  const uint8_t* p = raw.get();
+  const uint8_t* end = p + size;
+  if (size < 16) return 2;
+  if (!MagicMatches(p, "SOPL")) return 3;
+  const uint32_t version = ReadU32(p + 4);
+  if (version != 1) return 4;
+  const uint32_t num_entries = ReadU32(p + 8);
+  const uint32_t blob_size = ReadU32(p + 12);
+  p += 16;
+  const intptr_t entry_size = 24;
+  if (p + static_cast<intptr_t>(num_entries) * entry_size + blob_size > end)
+    return 5;
+  const uint8_t* blob_start = p + static_cast<intptr_t>(num_entries) * entry_size;
+
+  LinkData* ld = LinkData::Get();
+  ld->pool.clear();
+  ld->pool.reserve(num_entries);
+  for (uint32_t i = 0; i < num_entries; i++) {
+    PoolEntry e;
+    e.index = ReadU32(p + 0);
+    e.type_tag = ReadU32(p + 4);
+    // The third and fourth uint32 mean different things depending on
+    // type_tag. For TaggedObject: (cid, identity_offset, identity_length,
+    // padding). For Immediates: (raw_lo, raw_hi, 0, 0).
+    const uint32_t third = ReadU32(p + 8);
+    const uint32_t fourth = ReadU32(p + 12);
+    const uint32_t fifth = ReadU32(p + 16);
+    // const uint32_t sixth = ReadU32(p + 20);  // padding/unused
+    // We discriminate via type_tag — 1 in our writer = kTaggedObject.
+    if (e.type_tag == 1) {
+      e.cid = third;
+      const uint32_t id_off = fourth;
+      const uint32_t id_len = fifth;
+      if (id_off + id_len <= blob_size) {
+        e.identity.assign(
+            reinterpret_cast<const char*>(blob_start + id_off), id_len);
+      }
+      e.raw = 0;
+    } else {
+      e.cid = 0;
+      e.raw = static_cast<uint64_t>(third) |
+              (static_cast<uint64_t>(fourth) << 32);
+    }
+    ld->pool.push_back(std::move(e));
+    p += entry_size;
+  }
+  return 0;
+}
+
+intptr_t Dart_SankofaObjectPoolLinkCount() {
+  return LinkData::Get()->pool_count();
+}
+
+// =====================================================================
+// Dispatch-table reader
+// =====================================================================
+intptr_t Dart_LoadSankofaDispatchTableLinkData(const char* path) {
+  intptr_t size = 0;
+  std::unique_ptr<uint8_t, void (*)(void*)> raw(SlurpFile(path, &size),
+                                                 ::free);
+  if (raw == nullptr) return 1;
+  const uint8_t* p = raw.get();
+  const uint8_t* end = p + size;
+  if (size < 16) return 2;
+  if (!MagicMatches(p, "SDTL")) return 3;
+  const uint32_t version = ReadU32(p + 4);
+  if (version != 1) return 4;
+  const uint32_t length = ReadU32(p + 8);
+  const uint32_t blob_size = ReadU32(p + 12);
+  p += 16;
+  const intptr_t entry_size = 12;
+  if (p + static_cast<intptr_t>(length) * entry_size + blob_size > end)
+    return 5;
+  const uint8_t* blob_start = p + static_cast<intptr_t>(length) * entry_size;
+
+  LinkData* ld = LinkData::Get();
+  ld->dispatch.clear();
+  ld->dispatch.reserve(length);
+  for (uint32_t i = 0; i < length; i++) {
+    DispatchEntry e;
+    e.selector = ReadU32(p + 0);
+    const uint32_t name_offset = ReadU32(p + 4);
+    const uint32_t name_length = ReadU32(p + 8);
+    if (name_offset + name_length <= blob_size) {
+      e.name.assign(
+          reinterpret_cast<const char*>(blob_start + name_offset),
+          name_length);
+    }
+    ld->dispatch.push_back(std::move(e));
+    p += entry_size;
+  }
+  return 0;
+}
+
+intptr_t Dart_SankofaDispatchTableLinkCount() {
+  return LinkData::Get()->dispatch_count();
+}
+
+// =====================================================================
+// Lookup helpers — consulted by the patch precompiler so the patch
+// build's cid/offset/index assignments align with the base.
+//
+// All return -1 ("no base data for this key") when the relevant
+// LinkData table isn't loaded or the key isn't found; the caller
+// then falls back to whatever the precompiler would have chosen.
+// =====================================================================
+
+intptr_t Dart_SankofaLookupBaseCidByClassName(const char* name) {
+  if (name == nullptr) return -1;
+  LinkData* ld = LinkData::Get();
+  if (ld->classes.empty()) return -1;
+  const std::string target(name);
+  intptr_t found_cid = -1;
+  int matches = 0;
+  for (const auto& kv : ld->classes) {
+    if (kv.second.name == target) {
+      found_cid = static_cast<intptr_t>(kv.second.cid);
+      matches++;
+    }
+  }
+  // Ambiguous (e.g. two private '_Foo' classes in different libs) →
+  // refuse to guess. Caller MUST use the qualified variant when this
+  // can happen (it does for any name starting with '_').
+  if (matches > 1) return -1;
+  return found_cid;
+}
+
+intptr_t Dart_SankofaLookupBaseCidByQualifiedName(const char* library_uri,
+                                                  const char* name) {
+  if (name == nullptr) return -1;
+  LinkData* ld = LinkData::Get();
+  if (ld->classes.empty()) return -1;
+  const std::string target_name(name);
+  const std::string target_uri(library_uri != nullptr ? library_uri : "");
+  for (const auto& kv : ld->classes) {
+    if (kv.second.name == target_name &&
+        kv.second.library_uri == target_uri) {
+      return static_cast<intptr_t>(kv.second.cid);
+    }
+  }
+  return -1;
+}
+
+intptr_t Dart_SankofaLookupBaseFieldOffset(intptr_t owner_cid,
+                                           const char* field_name) {
+  if (field_name == nullptr) return -1;
+  LinkData* ld = LinkData::Get();
+  auto it = ld->fields_by_cid.find(static_cast<uint32_t>(owner_cid));
+  if (it == ld->fields_by_cid.end()) return -1;
+  const std::string target(field_name);
+  for (const FieldEntry& f : it->second.fields) {
+    if (f.name == target) {
+      return static_cast<intptr_t>(f.host_offset_in_bytes);
+    }
+  }
+  return -1;
+}
+
+intptr_t Dart_SankofaLookupBasePoolIndex(const char* identity) {
+  if (identity == nullptr) return -1;
+  LinkData* ld = LinkData::Get();
+  if (ld->pool.empty()) return -1;
+  const std::string target(identity);
+  for (const PoolEntry& e : ld->pool) {
+    if (e.type_tag == 1 && e.identity == target) {
+      return static_cast<intptr_t>(e.index);
+    }
+  }
+  return -1;
+}
+
+intptr_t Dart_SankofaLookupBaseDispatchSelectorByName(const char* name) {
+  if (name == nullptr) return -1;
+  LinkData* ld = LinkData::Get();
+  if (ld->dispatch.empty()) return -1;
+  const std::string target(name);
+  for (const DispatchEntry& e : ld->dispatch) {
+    if (e.name == target) {
+      return static_cast<intptr_t>(e.selector);
+    }
+  }
+  return -1;
+}
