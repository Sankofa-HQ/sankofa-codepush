+}  // namespace
+
+class SankofaSnapshotAnalyzer {
+ public:
+  SankofaSnapshotAnalyzer(const Dart_SnapshotAnalyzerInformation& info,
+                          bool disassemble)
+      : info_(info), disassemble_(disassemble) {}
+
+  void Run(char** buffer, intptr_t* buffer_length);
+
+ private:
+  void EmitSnapshotData();
+  void EmitFunctions();
+  void EmitCode(intptr_t index_in_entries, const Code& code, uword base_pc);
+
+  // Hash helpers. Self-hash normalizes ARM64 PC-relative branch immediates
+  // (B/BL/B.cond/CBZ/TBZ) so that base/patch builds with different link
+  // addresses still hash identically when the IL is semantically unchanged.
+  uint64_t ComputeSelfHash(const Code& code) const;
+  // Subgraph hash extends self_hash with a stable callee-identity chain.
+  // Today's version only adds op_subgraph_hash (TODO: full topological walk
+  // over Code-to-Code edges via the object pool).
+  uint64_t ComputeSubgraphHash(const Code& code) const;
+  // Object-pool subgraph hash mixes in the type tag of every pool entry
+  // plus the content hash of immediate-typed entries (kImmediate{,64,128}).
+  // Tagged objects are excluded today; they need stable per-object identity
+  // (function name / class id), tracked separately.
+  uint64_t ComputeOpSubgraphHash(const Code& code) const;
+
+  // Emit self_pp / subgraph_pp arrays for the current code object.
+  void EmitObjectPoolIndices(const Code& code);
+
+  // ARM64 IL normalization. Returns a heap-allocated buffer (free by caller)
+  // with the same length as `size`, where PC-relative immediate fields in
+  // every recognised branch instruction are zeroed.
+  uint8_t* NormalizeArm64Il(const uint8_t* start, intptr_t size) const;
+
+  // Hashes a stable identity for a heap object referenced from a
+  // tagged-object pool entry. The identity is deterministic across
+  // builds for the same logical object (function signature, string
+  // content, class id+name, integer value, etc.). Falls back to the
+  // class id when no specific case matches.
+  uint64_t HashTaggedObjectIdentity(const Object& obj) const;
+
+  // Walk a Code's IL and collect every global-object-pool index it
+  // references via LDR/STR Xt, [PP, #imm12*8] (Rn == PP register).
+  // De-duplicated and returned in ascending order.
+  std::vector<intptr_t> CollectArm64PoolIndices(const uint8_t* start,
+                                                intptr_t size) const;
+
+  // Transitive union of global-object-pool indices over the call graph:
+  // this Code's own pool indices plus those of every callee reached via
+  // pool Code/Function refs and direct B/BL branch targets, cycle-safe.
+  // Shares the traversal shape with ComputeTransitiveSubgraphHash and
+  // powers a real subgraph_pp (vs. mirroring self_pp).
+  void CollectTransitivePoolIndices(const Code& code,
+                                    std::set<intptr_t>* out,
+                                    std::unordered_set<uword>* visited) const;
+
+  const Dart_SnapshotAnalyzerInformation& info_;
+  const bool disassemble_;
+  JSONWriter js_;
+  Thread* thread_ = nullptr;
+
+  // Memoised transitive subgraph_hash per Code, keyed by the Code's raw
+  // ObjectPtr value. Filled lazily on demand. in_progress_ tracks Codes
+  // currently on the DFS stack so cycles resolve to a stable sentinel
+  // (0) instead of looping forever.
+  mutable std::unordered_map<uword, uint64_t> subgraph_cache_;
+  mutable std::unordered_set<uword> in_progress_;
+
+  // Code-by-payload-address index for resolving direct BL/B targets to
+  // their containing Code object. Populated once in Run() before
+  // EmitFunctions. Entries sorted by payload_start.
+  struct CodeIndexEntry {
+    uword payload_start;
+    uword payload_end;
+    uword code_ptr;
+  };
+  mutable std::vector<CodeIndexEntry> code_index_;
+
+  void BuildCodeIndex();
+  // Returns the Code whose payload contains `pc`, or null.
+  CodePtr CodeContaining(uword pc) const;
+  // Collect ARM64 B/BL target Codes referenced from `code`'s IL.
+  std::vector<uword> CollectArm64BranchTargets(const Code& code) const;
+
+  uint64_t ComputeTransitiveSubgraphHash(const Code& code) const;
+};
+
+void SankofaSnapshotAnalyzer::Run(char** buffer, intptr_t* buffer_length) {
+  thread_ = Thread::Current();
+  DARTSCOPE(thread_);
+
+  js_.OpenObject();
+  EmitSnapshotData();
+  {
+    SafepointReadRwLocker ml(thread_, thread_->isolate_group()->program_lock());
+    BuildCodeIndex();
+    EmitFunctions();
+  }
+  js_.CloseObject();
+  js_.Steal(buffer, buffer_length);
+}
+
+void SankofaSnapshotAnalyzer::BuildCodeIndex() {
+  Zone* zone = thread_->zone();
+  const auto& instruction_tables = GrowableObjectArray::Handle(
+      zone,
+      thread_->isolate_group()->object_store()->instructions_tables());
+  Code& code = Code::Handle(zone);
+  InstructionsTable& instructions_table = InstructionsTable::Handle(zone);
+  Array& code_objects = Array::Handle(zone);
+  for (intptr_t i = 0; i < instruction_tables.Length(); i++) {
+    instructions_table ^= instruction_tables.At(i);
+    code_objects = Array::RawCast(instructions_table.code_objects());
+    if (code_objects.IsNull()) continue;
+    for (intptr_t k = 0; k < code_objects.Length(); k++) {
+      code ^= code_objects.At(k);
+      if (code.IsNull()) continue;
+      const uword payload = code.PayloadStart();
+      const intptr_t size = code.Size();
+      if (size <= 0) continue;
+      code_index_.push_back({payload, payload + static_cast<uword>(size),
+                             static_cast<uword>(code.ptr())});
+    }
+  }
+  std::sort(code_index_.begin(), code_index_.end(),
+            [](const CodeIndexEntry& a, const CodeIndexEntry& b) {
+              return a.payload_start < b.payload_start;
+            });
+}
+
+CodePtr SankofaSnapshotAnalyzer::CodeContaining(uword pc) const {
+  // Binary search code_index_ for the entry whose [start, end) contains pc.
+  auto it = std::upper_bound(
+      code_index_.begin(), code_index_.end(), pc,
+      [](uword v, const CodeIndexEntry& e) { return v < e.payload_start; });
+  if (it == code_index_.begin()) return Code::null();
+  --it;
+  if (pc >= it->payload_start && pc < it->payload_end) {
+    return static_cast<CodePtr>(it->code_ptr);
+  }
+  return Code::null();
+}
+
+std::vector<uword> SankofaSnapshotAnalyzer::CollectArm64BranchTargets(
+    const Code& code) const {
+  std::vector<uword> targets;
+#if defined(TARGET_ARCH_ARM64)
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  if (size <= 0) return targets;
+  const uint8_t* bytes = reinterpret_cast<const uint8_t*>(start);
+  intptr_t i = 0;
+  const intptr_t aligned = size & ~static_cast<intptr_t>(3);
+  while (i + 4 <= aligned) {
+    const uint32_t insn = static_cast<uint32_t>(bytes[i]) |
+                          (static_cast<uint32_t>(bytes[i + 1]) << 8) |
+                          (static_cast<uint32_t>(bytes[i + 2]) << 16) |
+                          (static_cast<uint32_t>(bytes[i + 3]) << 24);
+    const uint32_t top6 = (insn >> 26) & 0x3F;
+    // B (0x05) or BL (0x25): imm26 at bits[25:0], sign-extended,
+    // shifted left 2 = byte offset from this instruction's PC.
+    if (top6 == 0x05 || top6 == 0x25) {
+      int32_t imm26 = static_cast<int32_t>(insn & 0x03FFFFFF);
+      // Sign-extend 26-bit value.
+      if (imm26 & 0x02000000) imm26 |= 0xFC000000;
+      const int64_t byte_offset = static_cast<int64_t>(imm26) * 4;
+      const uword pc = start + static_cast<uword>(i);
+      const uword target = pc + static_cast<uword>(byte_offset);
+      const CodePtr c = CodeContaining(target);
+      if (c != Code::null() && c != code.ptr()) {
+        targets.push_back(static_cast<uword>(c));
+      }
+    }
+    i += 4;
+  }
+  std::sort(targets.begin(), targets.end());
+  targets.erase(std::unique(targets.begin(), targets.end()), targets.end());
+#else
+  (void)code;
+#endif
+  return targets;
+}
+
+void SankofaSnapshotAnalyzer::EmitSnapshotData() {
+  // snapshot_data carries the section lengths + content hashes the
+  // Linker uses to verify base and patch came from the same kernel +
+  // toolchain. The Linker rejects mismatches with the
+  // "base and patch snapshots have differing VM sections" error.
+  //
+  // "adjusted_*" fields will eventually exclude codepush-mode padding
+  // that gen_snapshot inserts at link time so the base/patch length
+  // comparison stays stable across padded patch builds. We don't add
+  // that padding yet, so adjusted_* == raw lengths.
+  js_.OpenObject("snapshot_data");
+
+  // VM data + instructions section lengths come from the Image header
+  // each section starts with (constructed by gen_snapshot). Wrap in
+  // sanity bounds — when analyzing a cross-platform snapshot the
+  // section pointer may not actually point at a parseable header on
+  // the host (the loader mmap'd raw Mach-O / ELF segment bytes), in
+  // which case the read returns garbage. A multi-GB size is a strong
+  // signal the pointer didn't land at an Image header; fall back to 0.
+  constexpr intptr_t kMaxSaneSectionLen = 1u << 30;  // 1 GiB
+  intptr_t vm_data_len = 0;
+  intptr_t vm_instr_len = 0;
+  const uint8_t* vm_data_ptr = nullptr;
+  const uint8_t* vm_instr_ptr = nullptr;
+
+  // The Mach-O / ELF loader may populate either {vm_snapshot_*} or
+  // {vm_isolate_*} (or both) depending on how gen_snapshot split the
+  // sections for this target. Flutter iOS-release builds typically
+  // emit a single isolate snapshot with no separate VM snapshot, so we
+  // prefer isolate-* and fall back to vm-*.
+  vm_data_ptr = info_.vm_isolate_data != nullptr ? info_.vm_isolate_data
+                                                  : info_.vm_snapshot_data;
+  vm_instr_ptr = info_.vm_isolate_instructions != nullptr
+                     ? info_.vm_isolate_instructions
+                     : info_.vm_snapshot_instructions;
+
+  if (vm_data_ptr != nullptr) {
+    Image vm_data_image(vm_data_ptr);
+    const intptr_t len = vm_data_image.object_size();
+    if (len > 0 && len < kMaxSaneSectionLen) {
+      vm_data_len = len;
+    }
+  }
+  if (vm_instr_ptr != nullptr) {
+    Image vm_instr_image(vm_instr_ptr);
+    const intptr_t len = vm_instr_image.object_size();
+    if (len > 0 && len < kMaxSaneSectionLen) {
+      vm_instr_len = len;
+    }
+  }
+  // Spec wants lengths as decimal strings, not numbers (see
+  // SnapshotData.fromJson in research/.../snapshot_analysis.dart:23).
+  char buf[32];
+  std::snprintf(buf, sizeof(buf), "%" Pd, vm_data_len);
+  js_.PrintProperty("vm_data_length", buf);
+  std::snprintf(buf, sizeof(buf), "%" Pd, vm_instr_len);
+  js_.PrintProperty("adjusted_vm_instructions_length", buf);
+
+  // Section content hashes — FNV-1a over the bytes. Stable across
+  // builds because the snapshot is deterministic per (kernel, flags).
+  uint64_t vm_data_hash = 0;
+  uint64_t vm_instr_hash = 0;
+  if (vm_data_ptr != nullptr && vm_data_len > 0) {
+    Fnv64 h;
+    h.Update(vm_data_ptr, vm_data_len);
+    vm_data_hash = h.Finalize();
+  }
+  if (vm_instr_ptr != nullptr && vm_instr_len > 0) {
+    Fnv64 h;
+    h.Update(vm_instr_ptr, vm_instr_len);
+    vm_instr_hash = h.Finalize();
+  }
+  std::snprintf(buf, sizeof(buf), "%llu",
+                static_cast<unsigned long long>(vm_data_hash));
+  js_.PrintProperty("vm_data_hash", buf);
+  std::snprintf(buf, sizeof(buf), "%llu",
+                static_cast<unsigned long long>(vm_instr_hash));
+  js_.PrintProperty("adjusted_vm_instructions_hash", buf);
+
+  // Dart + snapshot versions. Both are nullable in the spec; emit when
+  // available.
+  const char* dart_version = Dart_VersionString();
+  if (dart_version != nullptr) {
+    js_.PrintProperty("dart_version", dart_version);
+  }
+  // snapshot_version is the format-version string baked into the
+  // snapshot by gen_snapshot; we can fish it out of the build_id of
+  // the instructions image when present.
+  if (vm_instr_ptr != nullptr) {
+    Image vm_instr_image(vm_instr_ptr);
+    const uint8_t* build_id = vm_instr_image.build_id();
+    const intptr_t build_id_len = vm_instr_image.build_id_length();
+    if (build_id != nullptr && build_id_len > 0) {
+      // Hex-encode the build id (up to 40 chars to fit common SHA1).
+      char hex[81];
+      const intptr_t out_len = std::min<intptr_t>(build_id_len, 40);
+      for (intptr_t i = 0; i < out_len; i++) {
+        std::snprintf(&hex[i * 2], 3, "%02x", build_id[i]);
+      }
+      hex[out_len * 2] = '\0';
+      js_.PrintProperty("snapshot_version", hex);
+    }
+  }
+
+  js_.CloseObject();
+}
+
+void SankofaSnapshotAnalyzer::EmitFunctions() {
+  js_.OpenArray("functions");
+
+  Zone* zone = thread_->zone();
+  Code& code = Code::Handle(zone);
+  const uword instruction_base =
+      reinterpret_cast<uword>(info_.vm_isolate_instructions);
+
+  // Iterate every Code object reachable from the snapshot via the
+  // instructions tables. This mirrors how the upstream analyzer enumerates
+  // Code (see analyze_snapshot_api_impl.cc DumpInterestingObjects).
+  const auto& instruction_tables = GrowableObjectArray::Handle(
+      zone,
+      thread_->isolate_group()->object_store()->instructions_tables());
+  auto& instructions_table = InstructionsTable::Handle(zone);
+
+  intptr_t emitted = 0;
+  for (intptr_t i = 0; i < instruction_tables.Length(); i++) {
+    instructions_table ^= instruction_tables.At(i);
+    const Array& code_objects = Array::Handle(
+        zone, Array::RawCast(instructions_table.code_objects()));
+    if (code_objects.IsNull()) continue;
+    for (intptr_t k = 0; k < code_objects.Length(); k++) {
+      code ^= code_objects.At(k);
+      if (code.IsNull()) continue;
+      EmitCode(emitted, code, instruction_base);
+      emitted++;
+    }
+  }
+
+  js_.CloseArray();
+}
+
+void SankofaSnapshotAnalyzer::EmitCode(intptr_t index_in_entries,
+                                       const Code& code,
+                                       uword instruction_base) {
+  js_.OpenObject();
+
+  // name
+  // Mirrors DumpCode in analyze_snapshot_api_impl.cc.
+  if (code.owner() != Object::null()) {
+    const auto& owner = Object::Handle(code.owner());
+    if (owner.IsFunction()) {
+      js_.PrintProperty("name", Function::Cast(owner).UserVisibleNameCString());
+    } else if (owner.IsClass()) {
+      char buf[256];
+      std::snprintf(buf, sizeof(buf), "new %s",
+                    Class::Cast(owner).ScrubbedNameCString());
+      js_.PrintProperty("name", buf);
+    } else if (owner.IsAbstractType()) {
+      char buf[256];
+      std::snprintf(buf, sizeof(buf), "as %s",
+                    AbstractType::Cast(owner).ScrubbedNameCString());
+      js_.PrintProperty("name", buf);
+    } else {
+      js_.PrintProperty("name", "<unknown>");
+    }
+  } else {
+    js_.PrintProperty("name", "<stub>");
+  }
+
+  js_.PrintProperty64("index_in_entries", index_in_entries);
+
+  const uword payload = code.PayloadStart();
+  const uword offset = payload - instruction_base;
+  js_.PrintProperty64("offset", static_cast<uint64_t>(offset));
+  js_.PrintProperty64("size", static_cast<uint64_t>(code.Size()));
+
+  // Hashes — see ComputeSelfHash / ComputeSubgraphHash /
+  // ComputeOpSubgraphHash for normalization details.
+  const uint64_t self_hash = ComputeSelfHash(code);
+  const uint64_t op_subgraph_hash = ComputeOpSubgraphHash(code);
+  const uint64_t subgraph_hash = ComputeSubgraphHash(code);
+
+  char hex_buf[17];
+  HashToHex(self_hash, hex_buf);
+  js_.PrintProperty("self_hash", hex_buf);
+  HashToHex(subgraph_hash, hex_buf);
+  js_.PrintProperty("subgraph_hash", hex_buf);
+  HashToHex(op_subgraph_hash, hex_buf);
+  js_.PrintProperty("op_subgraph_hash", hex_buf);
+
+  // self_pp: every ObjectPool index this Code's local pool exposes.
+  // subgraph_pp: the transitive union over the call graph (real as of the
+  // CollectTransitivePoolIndices walk below) — lets the linker reuse more
+  // of the base's pool layout, shrinking patches.
+  EmitObjectPoolIndices(code);
+
+  // subgraph_selectors / self_selectors / *_field_table / disassembly are
+  // all optional per the spec — omit when we don't have data. (The Code
+  // class's fromJson handles nulls.)
+
+  js_.CloseObject();
+}
+
+uint8_t* SankofaSnapshotAnalyzer::NormalizeArm64Il(const uint8_t* start,
+                                                  intptr_t size) const {
+  // Allocate a working copy.
+  uint8_t* out = static_cast<uint8_t*>(std::malloc(size));
+  if (out == nullptr) return nullptr;
+  std::memcpy(out, start, size);
+
+  // ARM64 is fixed-width 4-byte instructions, little-endian in memory.
+  // Walk every 4-byte word and zero PC-relative immediate fields of every
+  // instruction we know to be address-sensitive. The opcode + register
+  // fields stay verbatim; only the immediate offset bits are masked out,
+  // so functionally-equivalent code at different link addresses hashes
+  // identically.
+  intptr_t i = 0;
+  const intptr_t aligned = size & ~static_cast<intptr_t>(3);
+  while (i + 4 <= aligned) {
+    uint32_t insn = static_cast<uint32_t>(out[i]) |
+                    (static_cast<uint32_t>(out[i + 1]) << 8) |
+                    (static_cast<uint32_t>(out[i + 2]) << 16) |
+                    (static_cast<uint32_t>(out[i + 3]) << 24);
+    uint32_t masked = insn;
+
+    // B  (op = 0b000101_xx, top 6 bits = 0x14):       imm26 at [25:0]
+    // BL (op = 0b100101_xx, top 6 bits = 0x25):       imm26 at [25:0]
+    const uint32_t top6 = (insn >> 26) & 0x3F;
+    if (top6 == 0x05 || top6 == 0x25) {
+      masked &= 0xFC000000u;  // keep top 6 bits, zero imm26
+    } else {
+      // B.cond (bits[31:24] = 0x54):                  imm19 at [23:5]
+      const uint32_t top8 = (insn >> 24) & 0xFF;
+      if (top8 == 0x54) {
+        masked &= 0xFF00001Fu;  // keep [31:24] and [4:0], zero imm19
+      } else {
+        // CBZ/CBNZ (bits[30:25] = 0b011010):          imm19 at [23:5]
+        // TBZ/TBNZ (bits[30:25] = 0b011011):          imm14 at [18:5]
+        const uint32_t top7 = (insn >> 25) & 0x7F;
+        if (top7 == 0x34 || top7 == 0xB4) {
+          // CBZ (0b0_011010) or CBNZ (0b1_011010)
+          masked &= 0xFF00001Fu;  // zero imm19
+        } else if (top7 == 0x36 || top7 == 0xB6) {
+          // TBZ / TBNZ
+          masked &= 0xFFF8001Fu;  // zero imm14 at [18:5]
+        } else {
+          // ADR/ADRP: bits[28:24] = 0b10000, distinguish ADR (bit31=0) vs
+          //   ADRP (bit31=1). immlo at [30:29], immhi at [23:5]. Zero both.
+          const uint32_t bits_28_24 = (insn >> 24) & 0x1F;
+          if (bits_28_24 == 0x10) {
+            masked &= 0x9F00001Fu;  // keep bit31 + bits[28:24] + Rd, zero
+                                    // imms
+          }
+        }
+      }
+    }
+
+    if (masked != insn) {
+      out[i] = static_cast<uint8_t>(masked & 0xFF);
+      out[i + 1] = static_cast<uint8_t>((masked >> 8) & 0xFF);
+      out[i + 2] = static_cast<uint8_t>((masked >> 16) & 0xFF);
+      out[i + 3] = static_cast<uint8_t>((masked >> 24) & 0xFF);
+    }
+    i += 4;
+  }
+  return out;
+}
+
+uint64_t SankofaSnapshotAnalyzer::ComputeSelfHash(const Code& code) const {
+  // Hash the IL after normalizing PC-relative branch immediates. Two
+  // builds of the same Dart code at different link addresses produce
+  // identical self_hash values as long as the byte-level encoding of
+  // every non-branch instruction is the same.
+  //
+  // What's still not normalized today (TODO):
+  //  - PP-relative LDR/STR offsets: stable across builds because the
+  //    object pool is built deterministically from the same kernel, but
+  //    NOT stable when the patch's pool gains/loses entries. Patch-mode
+  //    gen_snapshot keeps these stable by aligning to base's pool layout.
+  //  - Constant immediates that encode addresses via MOVZ/MOVK
+  //    sequences (rare in Dart AOT).
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  if (size <= 0) {
+    return 0;
+  }
+  uint8_t* normalized = NormalizeArm64Il(reinterpret_cast<const uint8_t*>(start),
+                                         size);
+  if (normalized == nullptr) {
+    // Fall back to raw bytes on allocation failure.
+    Fnv64 h;
+    h.Update(reinterpret_cast<const void*>(start), size);
+    return h.Finalize();
+  }
+  Fnv64 h;
+  h.Update(normalized, size);
+  std::free(normalized);
+  return h.Finalize();
+}
+
+uint64_t SankofaSnapshotAnalyzer::HashTaggedObjectIdentity(
+    const Object& obj) const {
+  Fnv64 h;
+  if (obj.IsNull()) {
+    const uint8_t kind = 0;
+    h.Update(&kind, sizeof(kind));
+    return h.Finalize();
+  }
+  // Discriminate by ClassId so the kind byte is meaningful even when
+  // the rest of the body has nothing to add.
+  const intptr_t cid = obj.GetClassId();
+  h.Update(&cid, sizeof(cid));
+
+  if (obj.IsSmi()) {
+    const intptr_t v = Smi::Cast(obj).Value();
+    h.Update(&v, sizeof(v));
+    return h.Finalize();
+  }
+  if (obj.IsMint()) {
+    const int64_t v = Mint::Cast(obj).Value();
+    h.Update(&v, sizeof(v));
+    return h.Finalize();
+  }
+  if (obj.IsDouble()) {
+    const double v = Double::Cast(obj).value();
+    h.Update(&v, sizeof(v));
+    return h.Finalize();
+  }
+  if (obj.IsBool()) {
+    const bool v = Bool::Cast(obj).value();
+    h.Update(&v, sizeof(v));
+    return h.Finalize();
+  }
+  if (obj.IsString()) {
+    const String& s = String::Cast(obj);
+    const intptr_t len = s.Length();
+    h.Update(&len, sizeof(len));
+    const char* cstr = s.ToCString();
+    if (cstr != nullptr) {
+      h.Update(cstr, std::strlen(cstr));
+    }
+    return h.Finalize();
+  }
+  if (obj.IsClass()) {
+    const Class& c = Class::Cast(obj);
+    const intptr_t id = c.id();
+    h.Update(&id, sizeof(id));
+    const char* name = c.ScrubbedNameCString();
+    if (name != nullptr) {
+      h.Update(name, std::strlen(name));
+    }
+    return h.Finalize();
+  }
+  if (obj.IsFunction()) {
+    const Function& f = Function::Cast(obj);
+    const char* qname = f.QualifiedScrubbedNameCString();
+    if (qname != nullptr) {
+      h.Update(qname, std::strlen(qname));
+    }
+    // Mix in the owner class id too, so functions with the same scrubbed
+    // name on different classes still discriminate.
+    const Class& owner = Class::Handle(f.Owner());
+    if (!owner.IsNull()) {
+      const intptr_t owner_id = owner.id();
+      h.Update(&owner_id, sizeof(owner_id));
+    }
+    return h.Finalize();
+  }
+  if (obj.IsCode()) {
+    // A Code in the pool — identify by its owner function.
+    const Code& c = Code::Cast(obj);
+    if (c.owner() != Object::null()) {
+      const Object& owner = Object::Handle(c.owner());
+      if (owner.IsFunction()) {
+        return HashTaggedObjectIdentity(owner);
+      }
+      if (owner.IsClass()) {
+        return HashTaggedObjectIdentity(owner);
+      }
+    }
+    // Fall back to the code's payload size — at least somewhat stable
+    // across builds for unchanged code.
+    const intptr_t sz = c.Size();
+    h.Update(&sz, sizeof(sz));
+    return h.Finalize();
+  }
+  if (obj.IsField()) {
+    const Field& f = Field::Cast(obj);
+    const String& name = String::Handle(f.name());
+    if (!name.IsNull()) {
+      const char* cstr = name.ToCString();
+      if (cstr != nullptr) {
+        h.Update(cstr, std::strlen(cstr));
+      }
+    }
+    const Class& owner = Class::Handle(f.Owner());
+    if (!owner.IsNull()) {
+      const intptr_t owner_id = owner.id();
+      h.Update(&owner_id, sizeof(owner_id));
+    }
+    return h.Finalize();
+  }
+  // Default: type tag + cid only. Adequate for less-common pool object
+  // kinds (TypeArguments, AbstractType, ICData, etc) until we can
+  // identify a richer stable identity for each.
+  return h.Finalize();
+}
+
+uint64_t SankofaSnapshotAnalyzer::ComputeOpSubgraphHash(const Code& code) const {
+  // Walk this Code's IL, collect every global-object-pool index it
+  // references, then hash a stable identity for each referenced pool
+  // entry. Immediate-typed entries contribute their raw value
+  // (address-independent); tagged-object entries contribute the result
+  // of HashTaggedObjectIdentity (function signature, string content,
+  // class id+name, etc.) so two functions that reference different
+  // constants discriminate even when their IL is identical.
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  if (size <= 0) return Fnv64().Finalize();
+  const std::vector<intptr_t> indices = CollectArm64PoolIndices(
+      reinterpret_cast<const uint8_t*>(start), size);
+  Fnv64 h;
+  const auto* obj_store =
+      Thread::Current()->isolate_group()->object_store();
+  const ObjectPool& pool =
+      ObjectPool::Handle(obj_store->global_object_pool());
+  if (pool.IsNull()) return h.Finalize();
+  const intptr_t pool_len = pool.Length();
+  Object& obj = Object::Handle();
+  for (intptr_t idx : indices) {
+    h.Update(&idx, sizeof(idx));
+    if (idx < 0 || idx >= pool_len) continue;
+    const auto type = pool.TypeAt(idx);
+    const uint8_t t = static_cast<uint8_t>(type);
+    h.Update(&t, sizeof(t));
+    if (type == ObjectPool::EntryType::kTaggedObject) {
+      obj = pool.ObjectAt(idx);
+      const uint64_t identity = HashTaggedObjectIdentity(obj);
+      h.Update(&identity, sizeof(identity));
+    } else {
+      const uword raw = pool.RawValueAt(idx);
+      h.Update(&raw, sizeof(raw));
+    }
+  }
+  return h.Finalize();
+}
+
+uint64_t SankofaSnapshotAnalyzer::ComputeSubgraphHash(const Code& code) const {
+  // subgraph_hash = post-order Merkle hash over the call graph. The
+  // recursion enumerates each pool entry of type kTaggedObject pointing
+  // at a Code, computes the callee's subgraph_hash, and mixes the
+  // sorted set of callee hashes into the parent's hash state.
+  //
+  // Cycles (mutual recursion) resolve to 0 for the back-edge — the
+  // node's own self_hash + op_subgraph_hash still discriminate it; the
+  // cycle just doesn't add extra entropy. This is correct because
+  // unchanged mutually-recursive functions still produce identical
+  // subgraph_hashes in both builds.
+  return ComputeTransitiveSubgraphHash(code);
+}
+
+uint64_t SankofaSnapshotAnalyzer::ComputeTransitiveSubgraphHash(
+    const Code& code) const {
+  const uword key = static_cast<uword>(code.ptr());
+  auto cached = subgraph_cache_.find(key);
+  if (cached != subgraph_cache_.end()) {
+    return cached->second;
+  }
+  if (in_progress_.find(key) != in_progress_.end()) {
+    // Cycle back-edge — return sentinel.
+    return 0;
+  }
+  in_progress_.insert(key);
+
+  // Self contribution.
+  const uint64_t self = ComputeSelfHash(code);
+  const uint64_t op_subgraph = ComputeOpSubgraphHash(code);
+
+  // Find callee Codes referenced from this code via two channels:
+  //   (a) tagged-object pool entries that hold Code/Function refs, and
+  //   (b) direct B/BL branch targets resolved through the code_index_.
+  // Channel (b) catches trampolines that bypass the pool entirely.
+  std::vector<uint64_t> callee_hashes;
+  std::unordered_set<uword> seen_callees;
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  Code& callee = Code::Handle();
+  if (size > 0) {
+    // (a) pool-based callees.
+    const std::vector<intptr_t> indices = CollectArm64PoolIndices(
+        reinterpret_cast<const uint8_t*>(start), size);
+    const auto* obj_store =
+        Thread::Current()->isolate_group()->object_store();
+    const ObjectPool& pool =
+        ObjectPool::Handle(obj_store->global_object_pool());
+    if (!pool.IsNull()) {
+      const intptr_t pool_len = pool.Length();
+      Object& obj = Object::Handle();
+      for (intptr_t idx : indices) {
+        if (idx < 0 || idx >= pool_len) continue;
+        if (pool.TypeAt(idx) != ObjectPool::EntryType::kTaggedObject) {
+          continue;
+        }
+        obj = pool.ObjectAt(idx);
+        if (obj.IsNull()) continue;
+        if (obj.IsCode()) {
+          callee = Code::Cast(obj).ptr();
+        } else if (obj.IsFunction()) {
+          callee = Function::Cast(obj).CurrentCode();
+        } else {
+          continue;
+        }
+        if (callee.IsNull()) continue;
+        const uword ck = static_cast<uword>(callee.ptr());
+        if (!seen_callees.insert(ck).second) continue;
+        callee_hashes.push_back(ComputeTransitiveSubgraphHash(callee));
+      }
+    }
+    // (b) direct branch targets.
+    for (uword tgt_ptr : CollectArm64BranchTargets(code)) {
+      if (!seen_callees.insert(tgt_ptr).second) continue;
+      callee = static_cast<CodePtr>(tgt_ptr);
+      callee_hashes.push_back(ComputeTransitiveSubgraphHash(callee));
+    }
+  }
+  std::sort(callee_hashes.begin(), callee_hashes.end());
+
+  Fnv64 h;
+  h.Update(&self, sizeof(self));
+  h.Update(&op_subgraph, sizeof(op_subgraph));
+  const size_t ccount = callee_hashes.size();
+  h.Update(&ccount, sizeof(ccount));
+  for (uint64_t ch : callee_hashes) {
+    h.Update(&ch, sizeof(ch));
+  }
+  const uint64_t result = h.Finalize();
+
+  in_progress_.erase(key);
+  subgraph_cache_[key] = result;
+  return result;
+}
+
+std::vector<intptr_t> SankofaSnapshotAnalyzer::CollectArm64PoolIndices(
+    const uint8_t* start,
+    intptr_t size) const {
+  std::vector<intptr_t> indices;
+#if defined(TARGET_ARCH_ARM64)
+  // PP register number on ARM64 Dart AOT is 27 (see constants_arm64.h).
+  const uint32_t kPpRegNum = 27;
+  intptr_t i = 0;
+  const intptr_t aligned = size & ~static_cast<intptr_t>(3);
+  while (i + 4 <= aligned) {
+    const uint32_t insn = static_cast<uint32_t>(start[i]) |
+                          (static_cast<uint32_t>(start[i + 1]) << 8) |
+                          (static_cast<uint32_t>(start[i + 2]) << 16) |
+                          (static_cast<uint32_t>(start[i + 3]) << 24);
+    // LDR (immediate, unsigned offset, 64-bit):
+    //   bits[31:22] == 0b1111100101 (0x3E5)
+    //   bits[21:10] = imm12 (offset = imm12 * 8 for 64-bit)
+    //   bits[9:5]   = Rn (base register)
+    //   bits[4:0]   = Rt (dest register)
+    const uint32_t top10 = (insn >> 22) & 0x3FF;
+    if (top10 == 0x3E5) {
+      const uint32_t rn = (insn >> 5) & 0x1F;
+      if (rn == kPpRegNum) {
+        const uint32_t imm12 = (insn >> 10) & 0xFFF;
+        const intptr_t offset_bytes = static_cast<intptr_t>(imm12) * 8;
+        // Translate the PP-relative byte offset to a pool index. The
+        // offset assumes PP holds the tagged ObjectPool pointer, which
+        // is what IndexFromOffset accounts for.
+        const intptr_t idx = ObjectPool::IndexFromOffset(offset_bytes);
+        if (idx >= 0) indices.push_back(idx);
+      }
+    }
+    i += 4;
+  }
+  // De-dup + sort.
+  std::sort(indices.begin(), indices.end());
+  indices.erase(std::unique(indices.begin(), indices.end()), indices.end());
+#else
+  (void)start;
+  (void)size;
+#endif
+  return indices;
+}
+
+void SankofaSnapshotAnalyzer::CollectTransitivePoolIndices(
+    const Code& code,
+    std::set<intptr_t>* out,
+    std::unordered_set<uword>* visited) const {
+  const uword key = static_cast<uword>(code.ptr());
+  if (!visited->insert(key).second) return;  // cycle / already visited
+
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  if (size <= 0) return;
+
+  // This Code's own PP-relative pool indices.
+  const std::vector<intptr_t> indices = CollectArm64PoolIndices(
+      reinterpret_cast<const uint8_t*>(start), size);
+  for (intptr_t idx : indices) {
+    out->insert(idx);
+  }
+
+  // Recurse into callees via the same two channels as
+  // ComputeTransitiveSubgraphHash: (a) tagged-object pool entries holding
+  // a Code/Function, and (b) direct B/BL branch targets.
+  Code& callee = Code::Handle();
+  const auto* obj_store =
+      Thread::Current()->isolate_group()->object_store();
+  const ObjectPool& pool =
+      ObjectPool::Handle(obj_store->global_object_pool());
+  if (!pool.IsNull()) {
+    const intptr_t pool_len = pool.Length();
+    Object& obj = Object::Handle();
+    for (intptr_t idx : indices) {
+      if (idx < 0 || idx >= pool_len) continue;
+      if (pool.TypeAt(idx) != ObjectPool::EntryType::kTaggedObject) continue;
+      obj = pool.ObjectAt(idx);
+      if (obj.IsNull()) continue;
+      if (obj.IsCode()) {
+        callee = Code::Cast(obj).ptr();
+      } else if (obj.IsFunction()) {
+        callee = Function::Cast(obj).CurrentCode();
+      } else {
+        continue;
+      }
+      if (callee.IsNull()) continue;
+      CollectTransitivePoolIndices(callee, out, visited);
+    }
+  }
+  for (uword tgt_ptr : CollectArm64BranchTargets(code)) {
+    callee = static_cast<CodePtr>(tgt_ptr);
+    if (callee.IsNull()) continue;
+    CollectTransitivePoolIndices(callee, out, visited);
+  }
+}
+
+void SankofaSnapshotAnalyzer::EmitObjectPoolIndices(const Code& code) {
+  // self_pp: every global-object-pool index this Code references via a
+  // PP-relative LDR/STR. The Linker uses it to verify the patch's
+  // references stay aligned with the base's object-pool layout.
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  std::vector<intptr_t> self_indices;
+  if (size > 0) {
+    self_indices = CollectArm64PoolIndices(
+        reinterpret_cast<const uint8_t*>(start), size);
+  }
+  js_.OpenArray("self_pp");
+  for (intptr_t idx : self_indices) {
+    js_.PrintValue64(idx);
+  }
+  js_.CloseArray();
+
+  // subgraph_pp: transitive union of pool indices over the call graph
+  // (this Code + every callee reached via pool Code/Function refs and
+  // direct branch targets), cycle-safe — same traversal shape as
+  // ComputeTransitiveSubgraphHash. A real transitive set (vs. mirroring
+  // self_pp) lets the linker reuse more of the base's pool layout, which
+  // shrinks patches and raises link percentage.
+  std::set<intptr_t> subgraph_indices;
+  std::unordered_set<uword> visited;
+  CollectTransitivePoolIndices(code, &subgraph_indices, &visited);
+  js_.OpenArray("subgraph_pp");
+  for (intptr_t idx : subgraph_indices) {  // std::set iterates ascending
+    js_.PrintValue64(idx);
+  }
+  js_.CloseArray();
+}
+
+void Dart_DumpSankofaSnapshotAnalysisAsJson(
+    const Dart_SnapshotAnalyzerInformation& info,
+    bool disassemble,
+    char** buffer,
+    intptr_t* buffer_length) {
+  SankofaSnapshotAnalyzer analyzer(info, disassemble);
+  analyzer.Run(buffer, buffer_length);
+}
+
+}  // namespace snapshot_analyzer
+}  // namespace dart
