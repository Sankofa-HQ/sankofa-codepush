+// =====================================================================
+// Dispatch-table link data
+//
+// Binary file layout (little-endian throughout):
+//
+//   magic            : 4 bytes ASCII "SDTL"
+//   version          : uint32 = 1
+//   length           : uint32   (number of selector slots)
+//   name_blob_size   : uint32
+//   entries          : length * Entry
+//   name_blob        : packed UTF-8 strings
+//
+//   Entry =
+//     selector         : uint32   (0..length-1)
+//     name_offset      : uint32   (offset into name_blob, 0 if no resolution)
+//     name_length      : uint32   (0 if entry is null / unresolved)
+//
+// The Linker uses this to confirm that, for every selector, the patch
+// build's dispatch table resolves to the same function as the base.
+// =====================================================================
+
+namespace {
+
+// Locates the Code object whose instruction range contains `pc`.
+// Walks `instructions_tables` linearly. For a one-shot emit this is
+// O(num_codes); for repeated calls (e.g. the analyzer's per-Code path)
+// build an indexed structure once.
+CodePtr CodeContainingAddress(Thread* thread, uword pc) {
+  Zone* zone = thread->zone();
+  const auto& instruction_tables = GrowableObjectArray::Handle(
+      zone,
+      thread->isolate_group()->object_store()->instructions_tables());
+  Code& code = Code::Handle(zone);
+  InstructionsTable& instructions_table = InstructionsTable::Handle(zone);
+  Array& code_objects = Array::Handle(zone);
+  for (intptr_t i = 0; i < instruction_tables.Length(); i++) {
+    instructions_table ^= instruction_tables.At(i);
+    code_objects = Array::RawCast(instructions_table.code_objects());
+    if (code_objects.IsNull()) continue;
+    for (intptr_t k = 0; k < code_objects.Length(); k++) {
+      code ^= code_objects.At(k);
+      if (code.IsNull()) continue;
+      const uword start = code.PayloadStart();
+      const intptr_t size = code.Size();
+      if (size > 0 && pc >= start && pc < start + static_cast<uword>(size)) {
+        return code.ptr();
+      }
+    }
+  }
+  return Code::null();
+}
+
+// Returns the function-qualified-name for the Code at `pc`, or "" if
+// the address doesn't resolve to a Code we recognise.
+std::string ResolveFunctionNameForPc(Thread* thread, uword pc) {
+  CodePtr code_ptr = CodeContainingAddress(thread, pc);
+  if (code_ptr == Code::null()) return std::string();
+  const Code& code = Code::Handle(thread->zone(), code_ptr);
+  if (code.owner() == Object::null()) return std::string();
+  const Object& owner = Object::Handle(thread->zone(), code.owner());
+  if (owner.IsFunction()) {
+    const char* qname =
+        Function::Cast(owner).QualifiedScrubbedNameCString();
+    return qname != nullptr ? std::string(qname) : std::string();
+  }
+  if (owner.IsClass()) {
+    const char* cname = Class::Cast(owner).ScrubbedNameCString();
+    return std::string("class:") + (cname != nullptr ? cname : "");
+  }
+  return std::string();
+}
+
+}  // namespace
+
+intptr_t Dart_WriteSankofaDispatchTableLinkData(const char* path) {
+  if (path == nullptr) return 1;
+  Thread* thread = Thread::Current();
+  if (thread == nullptr) return 1;
+  DARTSCOPE(thread);
+
+  DispatchTable* dt = thread->isolate_group()->dispatch_table();
+  if (dt == nullptr) {
+    // Emit a valid-but-empty file.
+    Buf b;
+    b.Magic4("SDTL");
+    b.U32(1);
+    b.U32(0);
+    b.U32(0);
+    return WriteFileBytes(path, b.data().data(),
+                          static_cast<intptr_t>(b.data().size()));
+  }
+
+  const intptr_t len = dt->length();
+  const uword* arr = dt->ArrayOrigin();
+  // dt->ArrayOrigin() returns the pointer the DT register lives in,
+  // which is offset by kOriginElement from the underlying array start.
+  // We want the raw array, which starts kOriginElement entries before.
+  arr -= DispatchTable::kOriginElement;
+
+  Buf header;
+  header.Magic4("SDTL");
+  header.U32(1);  // version
+
+  Buf entries;
+  std::string name_blob;
+
+  for (intptr_t i = 0; i < len; i++) {
+    const uword pc = arr[i];
+    std::string name;
+    if (pc != 0) {
+      name = ResolveFunctionNameForPc(thread, pc);
+    }
+    const uint32_t name_offset = static_cast<uint32_t>(name_blob.size());
+    const uint32_t name_length = static_cast<uint32_t>(name.size());
+    entries.U32(static_cast<uint32_t>(i));
+    entries.U32(name_offset);
+    entries.U32(name_length);
+    if (!name.empty()) {
+      name_blob.append(name);
+    }
+  }
+
+  header.U32(static_cast<uint32_t>(len));
+  header.U32(static_cast<uint32_t>(name_blob.size()));
+
+  std::vector<uint8_t> file_bytes;
+  file_bytes.reserve(header.data().size() + entries.data().size() +
+                     name_blob.size());
+  file_bytes.insert(file_bytes.end(), header.data().begin(),
+                    header.data().end());
+  file_bytes.insert(file_bytes.end(), entries.data().begin(),
+                    entries.data().end());
+  file_bytes.insert(file_bytes.end(),
+                    reinterpret_cast<const uint8_t*>(name_blob.data()),
+                    reinterpret_cast<const uint8_t*>(name_blob.data() +
+                                                     name_blob.size()));
+  return WriteFileBytes(path, file_bytes.data(),
+                        static_cast<intptr_t>(file_bytes.size()));
+}
+
+intptr_t Dart_WriteSankofaDispatchTableLinkDebugInfo(const char* path) {
+  if (path == nullptr) return 1;
+  Thread* thread = Thread::Current();
+  if (thread == nullptr) return 1;
+  DARTSCOPE(thread);
+
+  DispatchTable* dt = thread->isolate_group()->dispatch_table();
+  JSONWriter js;
+  js.OpenObject();
+  js.PrintProperty("format", "sankofa.dispatch_table");
+  js.PrintProperty64("version", 1);
+  if (dt == nullptr) {
+    js.PrintProperty64("length", 0);
+    js.OpenArray("entries");
+    js.CloseArray();
+    js.CloseObject();
+    char* buf = nullptr;
+    intptr_t buf_len = 0;
+    js.Steal(&buf, &buf_len);
+    intptr_t result = WriteFileBytes(path, buf, buf_len);
+    std::free(buf);
+    return result;
+  }
+  const intptr_t len = dt->length();
+  const uword* arr = dt->ArrayOrigin() - DispatchTable::kOriginElement;
+  js.PrintProperty64("length", len);
+  js.OpenArray("entries");
+  for (intptr_t i = 0; i < len; i++) {
+    const uword pc = arr[i];
+    std::string name =
+        (pc != 0) ? ResolveFunctionNameForPc(thread, pc) : std::string();
+    if (name.empty()) continue;  // skip unresolved slots in debug JSON
+    js.OpenObject();
+    js.PrintProperty64("selector", i);
+    js.PrintProperty("name", name.c_str());
+    js.CloseObject();
+  }
+  js.CloseArray();
+  js.CloseObject();
+  char* buf = nullptr;
+  intptr_t buf_len = 0;
+  js.Steal(&buf, &buf_len);
+  intptr_t result = WriteFileBytes(path, buf, buf_len);
+  std::free(buf);
+  return result;
+}
