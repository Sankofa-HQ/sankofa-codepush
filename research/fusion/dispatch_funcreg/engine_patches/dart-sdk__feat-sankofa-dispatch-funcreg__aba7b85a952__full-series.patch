+std::vector<uint64_t> SankofaSnapshotAnalyzer::CollectDirectCalleeHashes(
+    const Code& code) const {
+  std::vector<uint64_t> out;
+  const uword start = code.PayloadStart();
+  const intptr_t size = code.Size();
+  if (size <= 0) return out;
+  std::unordered_set<uword> seen;
+  Code& callee = Code::Handle();
+  const auto* obj_store = Thread::Current()->isolate_group()->object_store();
+  const ObjectPool& pool =
+      ObjectPool::Handle(obj_store->global_object_pool());
+  const std::vector<intptr_t> indices = CollectArm64PoolIndices(
+      reinterpret_cast<const uint8_t*>(start), size);
+  if (!pool.IsNull()) {
+    const intptr_t pool_len = pool.Length();
+    Object& obj = Object::Handle();
+    for (intptr_t idx : indices) {
+      if (idx < 0 || idx >= pool_len) continue;
+      if (pool.TypeAt(idx) != ObjectPool::EntryType::kTaggedObject) continue;
+      obj = pool.ObjectAt(idx);
+      if (obj.IsNull()) continue;
+      if (obj.IsCode()) {
+        callee = Code::Cast(obj).ptr();
+      } else if (obj.IsFunction()) {
+        callee = Function::Cast(obj).CurrentCode();
+      } else {
+        continue;
+      }
+      if (callee.IsNull()) continue;
+      if (!seen.insert(static_cast<uword>(callee.ptr())).second) continue;
+      out.push_back(ComputeSubgraphHash(callee));
+    }
+  }
+  for (uword tgt_ptr : CollectArm64BranchTargets(code)) {
+    if (!seen.insert(tgt_ptr).second) continue;
+    callee = static_cast<CodePtr>(tgt_ptr);
+    if (callee.IsNull()) continue;
+    out.push_back(ComputeSubgraphHash(callee));
+  }
+  return out;
+}
+
+void SankofaSnapshotAnalyzer::ComputeDdTable(const char* dd_table_path,
+                                             const char* caller_links_path,
+                                             int64_t dd_max_bytes) {
+  thread_ = Thread::Current();
+  DARTSCOPE(thread_);
+  SafepointReadRwLocker ml(thread_, thread_->isolate_group()->program_lock());
+  BuildCodeIndex();
+
+  Zone* zone = thread_->zone();
+  Code& code = Code::Handle(zone);
+  const auto& instruction_tables = GrowableObjectArray::Handle(
+      zone, thread_->isolate_group()->object_store()->instructions_tables());
+  auto& instructions_table = InstructionsTable::Handle(zone);
+
+  // fan_in: subgraph_hash -> number of distinct calling functions.
+  // order:  functions in first-seen order (deterministic output).
+  std::unordered_map<uint64_t, uint32_t> fan_in;
+  std::vector<uint64_t> order;
+  std::unordered_set<uint64_t> seen_fn;
+
+  for (intptr_t i = 0; i < instruction_tables.Length(); i++) {
+    instructions_table ^= instruction_tables.At(i);
+    const Array& code_objects = Array::Handle(
+        zone, Array::RawCast(instructions_table.code_objects()));
+    if (code_objects.IsNull()) continue;
+    for (intptr_t k = 0; k < code_objects.Length(); k++) {
+      code ^= code_objects.At(k);
+      if (code.IsNull()) continue;
+      const uint64_t h = ComputeSubgraphHash(code);
+      if (seen_fn.insert(h).second) {
+        order.push_back(h);
+        fan_in[h];  // ensure key present even if never called
+      }
+      for (uint64_t callee_h : CollectDirectCalleeHashes(code)) {
+        fan_in[callee_h] += 1;
+      }
+    }
+  }
+
+  // Rank by fan-in desc (stable hash tiebreak); assign DD slots up to the
+  // byte budget. Each slot has a fixed indirection overhead; the budget
+  // caps the total. Only functions with >1 caller earn a slot.
+  constexpr int64_t kPerSlotBytes = 8;
+  const int64_t max_slots =
+      dd_max_bytes > 0 ? (dd_max_bytes / kPerSlotBytes) : 0;
+  std::vector<uint64_t> ranked(order);
+  std::sort(ranked.begin(), ranked.end(),
+            [&fan_in](uint64_t a, uint64_t b) {
+              const uint32_t fa = fan_in[a], fb = fan_in[b];
+              if (fa != fb) return fa > fb;
+              return a < b;
+            });
+
+  // dd_table (LE): 'SDDT'(u32) | version(u32=1) | count(u32) |
+  //   [ subgraph_hash(u64) | slot(u32) | fan_in(u32) ] * count
+  DdBuf t;
+  t.U32(0x54444453u);  // "SDDT"
+  t.U32(1u);
+  std::vector<std::pair<uint64_t, uint32_t>> selected;
+  for (uint64_t h : ranked) {
+    if (static_cast<int64_t>(selected.size()) >= max_slots) break;
+    if (fan_in[h] < 2) break;  // ranked desc; nothing below is worth a slot
+    selected.emplace_back(h, static_cast<uint32_t>(selected.size()));
+  }
+  t.U32(static_cast<uint32_t>(selected.size()));
+  for (const auto& s : selected) {
+    t.U64(s.first);
+    t.U32(s.second);
+    t.U32(fan_in[s.first]);
+  }
+  DdWriteFile(dd_table_path, t);
+
+  // dd_caller_links (LE): 'SDCL'(u32) | version(u32=1) | count(u32) |
+  //   [ subgraph_hash(u64) | fan_in(u32) ] * count
+  DdBuf c;
+  c.U32(0x4C434453u);  // "SDCL"
+  c.U32(1u);
+  c.U32(static_cast<uint32_t>(order.size()));
+  for (uint64_t h : order) {
+    c.U64(h);
+    c.U32(fan_in[h]);
+  }
+  DdWriteFile(caller_links_path, c);
+}
