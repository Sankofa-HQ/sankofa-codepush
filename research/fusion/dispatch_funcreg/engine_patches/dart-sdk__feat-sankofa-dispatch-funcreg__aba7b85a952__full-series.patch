+namespace dart {
+namespace snapshot_analyzer {
+
+namespace {
+
+// Writes `buffer` of `len` bytes to `path` (truncate-create). Returns
+// 0 on success, 1 on any failure.
+intptr_t WriteFileBytes(const char* path, const void* buffer, intptr_t len) {
+  if (path == nullptr) return 1;
+  std::FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) return 1;
+  size_t wrote = 0;
+  if (len > 0 && buffer != nullptr) {
+    wrote = std::fwrite(buffer, 1, static_cast<size_t>(len), f);
+  }
+  std::fclose(f);
+  return (static_cast<intptr_t>(wrote) == len) ? 0 : 1;
+}
+
+// Little-endian byte writer for the binary format.
+class Buf {
+ public:
+  void U32(uint32_t v) {
+    bytes_.push_back(static_cast<uint8_t>(v & 0xFF));
+    bytes_.push_back(static_cast<uint8_t>((v >> 8) & 0xFF));
+    bytes_.push_back(static_cast<uint8_t>((v >> 16) & 0xFF));
+    bytes_.push_back(static_cast<uint8_t>((v >> 24) & 0xFF));
+  }
+  void U64(uint64_t v) {
+    for (int i = 0; i < 8; i++) {
+      bytes_.push_back(static_cast<uint8_t>((v >> (i * 8)) & 0xFF));
+    }
+  }
+  void Bytes(const void* p, intptr_t n) {
+    if (n <= 0 || p == nullptr) return;
+    const uint8_t* b = static_cast<const uint8_t*>(p);
+    bytes_.insert(bytes_.end(), b, b + n);
+  }
+  void Magic4(const char* s) {
+    Bytes(s, 4);
+  }
+  const std::vector<uint8_t>& data() const { return bytes_; }
+
+ private:
+  std::vector<uint8_t> bytes_;
+};
+
+}  // namespace
+
+// =====================================================================
+// Class-table link data (v2)
+//
+// Binary file layout (little-endian throughout):
+//
+//   magic            : 4 bytes ASCII "SCTL"
+//   version          : uint32 = 2     (v1: no library_uri)
+//   num_classes      : uint32
+//   name_blob_size   : uint32         (bytes in trailing string blob;
+//                                      holds class names AND library uris)
+//   entries          : num_classes * Entry
+//   name_blob        : packed UTF-8 strings (no null terminators)
+//
+//   Entry =
+//     cid                       : uint32
+//     super_cid                 : uint32   (0 if none / kIllegalCid)
+//     instance_size_in_words    : uint32
+//     num_type_arguments        : int32    (-1 if none)
+//     name_offset               : uint32   (offset into name_blob)
+//     name_length               : uint32   (bytes, NOT codepoints)
+//     library_uri_offset        : uint32   (v2: 0 if no library / VM-internal)
+//     library_uri_length        : uint32   (v2: 0 when no uri)
+//     flags                     : uint32   (bitfield, see below)
+//
+//   flags bits:
+//     0x1 = is_abstract
+//     0x2 = is_top_level
+//     0x4 = is_implementation_class
+//     0x8 = is_const
+//
+// v2 motivation: two private classes named `_Foo` in different libraries
+// collapse onto the same Class::Name() in Dart's API. v1 keyed by short
+// name only, so the patch precompiler could pre-set the wrong cid for
+// private classes. v2 includes the library uri so the lookup is keyed by
+// (library_uri, name) and remains unambiguous.
+// =====================================================================
+
+intptr_t Dart_WriteSankofaClassTableLinkData(const char* path) {
+  if (path == nullptr) return 1;
+  Thread* thread = Thread::Current();
+  if (thread == nullptr) return 1;
+  DARTSCOPE(thread);
+  auto* class_table = thread->isolate_group()->class_table();
+  if (class_table == nullptr) return 1;
+  const intptr_t num_cids = class_table->NumCids();
+
+  Buf header;
+  header.Magic4("SCTL");
+  header.U32(2);  // version (v2 adds library_uri)
+
+  Buf entries;
+  std::string name_blob;
+  uint32_t emitted = 0;
+
+  Class& cls = Class::Handle(thread->zone());
+  String& name_handle = String::Handle(thread->zone());
+  Library& library = Library::Handle(thread->zone());
+  String& library_uri_handle = String::Handle(thread->zone());
+
+  for (intptr_t cid = 0; cid < num_cids; cid++) {
+    if (!class_table->HasValidClassAt(cid)) continue;
+    cls = class_table->At(cid);
+    if (cls.IsNull()) continue;
+
+    // Name (scrubbed).
+    name_handle = cls.Name();
+    std::string name;
+    if (!name_handle.IsNull()) {
+      const char* cstr = name_handle.ToCString();
+      if (cstr != nullptr) name = cstr;
+    }
+
+    // Library URI (canonical, used for disambiguation across libs).
+    std::string library_uri;
+    library = cls.library();
+    if (!library.IsNull()) {
+      library_uri_handle = library.url();
+      if (!library_uri_handle.IsNull()) {
+        const char* cstr = library_uri_handle.ToCString();
+        if (cstr != nullptr) library_uri = cstr;
+      }
+    }
+
+    // Compute super cid (kIllegalCid → 0 marker).
+    intptr_t super_cid = 0;
+    {
+      const Class& super = Class::Handle(thread->zone(),
+                                         cls.SuperClass());
+      if (!super.IsNull()) super_cid = super.id();
+    }
+
+    // Instance size (in words).
+    const intptr_t instance_size_in_bytes = cls.host_instance_size();
+    const intptr_t instance_size_in_words =
+        instance_size_in_bytes / compiler::target::kWordSize;
+
+    // num_type_arguments — -1 sentinel if undefined.
+    intptr_t nta = cls.NumTypeArguments();
+
+    // Flags.
+    uint32_t flags = 0;
+    if (cls.is_abstract()) flags |= 0x1;
+    if (cls.IsTopLevel()) flags |= 0x2;
+    // is_implementation_class isn't exposed in the 3.12 API; bit 0x4
+    // reserved for it once we wire to ClassFinalizer state.
+    if (cls.is_const()) flags |= 0x8;
+
+    const uint32_t name_offset = static_cast<uint32_t>(name_blob.size());
+    const uint32_t name_length = static_cast<uint32_t>(name.size());
+    name_blob.append(name);
+    const uint32_t library_uri_offset =
+        library_uri.empty() ? 0
+                            : static_cast<uint32_t>(name_blob.size());
+    const uint32_t library_uri_length =
+        static_cast<uint32_t>(library_uri.size());
+    if (!library_uri.empty()) {
+      name_blob.append(library_uri);
+    }
+
+    entries.U32(static_cast<uint32_t>(cid));
+    entries.U32(static_cast<uint32_t>(super_cid));
+    entries.U32(static_cast<uint32_t>(instance_size_in_words));
+    entries.U32(static_cast<uint32_t>(static_cast<int32_t>(nta)));
+    entries.U32(name_offset);
+    entries.U32(name_length);
+    entries.U32(library_uri_offset);
+    entries.U32(library_uri_length);
+    entries.U32(flags);
+
+    emitted++;
+  }
+
+  header.U32(emitted);
+  header.U32(static_cast<uint32_t>(name_blob.size()));
+
+  // Compose: header || entries || name_blob.
+  std::vector<uint8_t> file_bytes;
+  file_bytes.reserve(header.data().size() + entries.data().size() +
+                     name_blob.size());
+  file_bytes.insert(file_bytes.end(), header.data().begin(),
+                    header.data().end());
+  file_bytes.insert(file_bytes.end(), entries.data().begin(),
+                    entries.data().end());
+  file_bytes.insert(file_bytes.end(),
+                    reinterpret_cast<const uint8_t*>(name_blob.data()),
+                    reinterpret_cast<const uint8_t*>(name_blob.data() +
+                                                     name_blob.size()));
+  return WriteFileBytes(path, file_bytes.data(),
+                        static_cast<intptr_t>(file_bytes.size()));
+}
