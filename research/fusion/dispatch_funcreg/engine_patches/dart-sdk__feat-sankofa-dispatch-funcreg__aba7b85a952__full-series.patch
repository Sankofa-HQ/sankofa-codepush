+// Returns the current code entry-point of |name| in |library| (0 on error).
+// Capture this BEFORE transplanting a function to bytecode: a virtual method's
+// dispatch-table slots hold this entry, and Dart_SankofaRepointDispatchToInterpret
+// scans for it to reroute them.
+uintptr_t Dart_SankofaCodeEntryForName(const char* name) {
+  Thread* thread = Thread::Current();
+  if (thread == nullptr || name == nullptr) return 0;
+  DARTSCOPE(thread);
+  const Library& lib = Library::Handle(
+      thread->zone(), thread->isolate_group()->object_store()->root_library());
+  if (lib.IsNull()) return 0;
+  const Function& fn =
+      Function::Handle(thread->zone(), ResolveSankofaFn(thread, lib, name));
+  if (fn.IsNull() || !fn.HasCode()) return 0;
+  return static_cast<uintptr_t>(Code::EntryPointOf(fn.CurrentCode()));
