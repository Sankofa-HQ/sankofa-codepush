+namespace dart {
+namespace snapshot_analyzer {
+
+// Schema version we emit. Bumped any time the JSON shape changes in a way
+// that requires linker awareness. Reserved for future schema evolution.
+[[maybe_unused]] constexpr intptr_t kSankofaSchemaVersion = 1;
+
+namespace {
+
+// Stable FNV-1a 64-bit hash, used as the placeholder hash function until we
+// implement the IL-normalized Merkle hash described in the design doc. FNV
+// is deterministic across builds for identical input bytes, so it preserves
+// the Linker's invariant ("same function → same hash"); it just doesn't
+// normalize away absolute-address bytes, so functions that reference
+// different absolute addresses across base/patch builds will hash
+// differently even when their source code is identical.
+//
+// TODO(sankofa-codepush): replace with IL-normalized Merkle hash. See
+// CODEPUSH_SPEC.md §6a + design discussion in research/.
+class Fnv64 {
+ public:
+  static constexpr uint64_t kOffset = 0xcbf29ce484222325ULL;
+  static constexpr uint64_t kPrime = 0x100000001b3ULL;
+
+  Fnv64() : h_(kOffset) {}
+
+  void Update(const void* data, size_t len) {
+    const uint8_t* p = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < len; i++) {
+      h_ ^= static_cast<uint64_t>(p[i]);
+      h_ *= kPrime;
+    }
+  }
+
+  uint64_t Finalize() const { return h_; }
+
+ private:
+  uint64_t h_;
+};
+
+// Format a 64-bit hash as a fixed 16-char hex string (no 0x prefix), like
+// Shorebird's `Hash.long` field.
+void HashToHex(uint64_t v, char out[17]) {
+  std::snprintf(out, 17, "%016llx", static_cast<unsigned long long>(v));
+}
