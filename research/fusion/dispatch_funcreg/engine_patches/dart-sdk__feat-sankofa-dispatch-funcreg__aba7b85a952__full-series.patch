+  Thread* thread = Thread::Current();
+  if (thread == nullptr || name == nullptr || old_entry == 0) return -1;
+  DARTSCOPE(thread);
+  const Library& lib = Library::Handle(
+      thread->zone(), thread->isolate_group()->object_store()->root_library());
+  if (lib.IsNull()) return -1;
+  const Function& fn =
+      Function::Handle(thread->zone(), ResolveSankofaFn(thread, lib, name));
+  if (fn.IsNull()) return -1;
+  DispatchTable* dt = thread->isolate_group()->dispatch_table();
+  if (dt == nullptr) return -1;
+  const uword trampoline = StubCode::SankofaDispatchInterpret().EntryPoint();
+  uword* arr = dt->mutable_array();
+  const intptr_t len = dt->length();
+  const uword fn_ptr = static_cast<uword>(fn.ptr());
+  const uword want = static_cast<uword>(old_entry);
+  intptr_t repointed = 0;
+  for (intptr_t i = 0; i < len; i++) {
+    const intptr_t e = DispatchTable::kSlotStride * i;
+    if (arr[e] == want) {
+      arr[e] = trampoline;
+      arr[e + 1] = fn_ptr;
+      repointed++;
+    }
+  }
+  return repointed;
