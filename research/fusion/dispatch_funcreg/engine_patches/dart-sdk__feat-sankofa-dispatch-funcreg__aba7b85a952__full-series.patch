+// =====================================================================
+// Object-pool link data
+//
+// Binary file layout (little-endian throughout):
+//
+//   magic           : 4 bytes ASCII "SOPL"
+//   version         : uint32 = 1
+//   num_entries     : uint32
+//   identity_blob_size : uint32
+//   entries         : num_entries * Entry
+//   identity_blob   : packed UTF-8 strings (no null terminators)
+//
+//   Entry =
+//     index            : uint32   (pool index)
+//     type_tag         : uint32   (0=TaggedObject, 1=Imm, 2=Imm64, 3=Imm128)
+//     // for type_tag==0 (TaggedObject):
+//     cid              : uint32
+//     identity_offset  : uint32   (offset into identity_blob)
+//     identity_length  : uint32   (bytes)
+//     padding          : uint32   (reserved, must be 0)
+//     // for type_tag!=0 (immediates):
+//     raw_lo           : uint32   (immediate low 32 bits)
+//     raw_hi           : uint32   (immediate high 32 bits — 0 for 32-bit)
+//     identity_offset  : uint32   (0 — unused)
+//     identity_length  : uint32   (0 — unused)
+//
+// Each entry is 24 bytes. Both encodings share the same physical layout
+// so a reader can advance uniformly.
+// =====================================================================
+
+intptr_t Dart_WriteSankofaObjectPoolLinkData(const char* path) {
+  if (path == nullptr) return 1;
+  Thread* thread = Thread::Current();
+  if (thread == nullptr) return 1;
+  DARTSCOPE(thread);
+
+  const ObjectPool& pool = ObjectPool::Handle(
+      thread->isolate_group()->object_store()->global_object_pool());
+  if (pool.IsNull()) {
+    // Empty file — magic + 0 entries.
+    Buf b;
+    b.Magic4("SOPL");
+    b.U32(1);
+    b.U32(0);
+    b.U32(0);
+    return WriteFileBytes(path, b.data().data(),
+                          static_cast<intptr_t>(b.data().size()));
+  }
+  const intptr_t pool_len = pool.Length();
+  Buf header;
+  header.Magic4("SOPL");
+  header.U32(1);  // version
+
+  Buf entries;
+  std::string identity_blob;
+
+  Object& obj = Object::Handle();
+  for (intptr_t i = 0; i < pool_len; i++) {
+    entries.U32(static_cast<uint32_t>(i));
+    const auto type = pool.TypeAt(i);
+    const uint32_t type_tag = static_cast<uint32_t>(type);
+    entries.U32(type_tag);
+    if (type == ObjectPool::EntryType::kTaggedObject) {
+      obj = pool.ObjectAt(i);
+      const intptr_t cid = obj.IsNull() ? 0 : obj.GetClassId();
+      entries.U32(static_cast<uint32_t>(cid));
+      const std::string identity = TaggedIdentityCString(obj);
+      const uint32_t identity_offset =
+          static_cast<uint32_t>(identity_blob.size());
+      const uint32_t identity_length =
+          static_cast<uint32_t>(identity.size());
+      entries.U32(identity_offset);
+      entries.U32(identity_length);
+      entries.U32(0);  // padding
+      identity_blob.append(identity);
+    } else {
+      const uword raw = pool.RawValueAt(i);
+      const uint32_t lo = static_cast<uint32_t>(raw & 0xFFFFFFFFu);
+      const uint32_t hi = static_cast<uint32_t>(
+          (static_cast<uint64_t>(raw) >> 32) & 0xFFFFFFFFu);
+      entries.U32(lo);
+      entries.U32(hi);
+      entries.U32(0);  // identity_offset (unused)
+      entries.U32(0);  // identity_length (unused)
+    }
+  }
+
+  header.U32(static_cast<uint32_t>(pool_len));
+  header.U32(static_cast<uint32_t>(identity_blob.size()));
+
+  std::vector<uint8_t> file_bytes;
+  file_bytes.reserve(header.data().size() + entries.data().size() +
+                     identity_blob.size());
+  file_bytes.insert(file_bytes.end(), header.data().begin(),
+                    header.data().end());
+  file_bytes.insert(file_bytes.end(), entries.data().begin(),
+                    entries.data().end());
+  file_bytes.insert(
+      file_bytes.end(),
+      reinterpret_cast<const uint8_t*>(identity_blob.data()),
+      reinterpret_cast<const uint8_t*>(identity_blob.data() +
+                                       identity_blob.size()));
+  return WriteFileBytes(path, file_bytes.data(),
+                        static_cast<intptr_t>(file_bytes.size()));
+}
