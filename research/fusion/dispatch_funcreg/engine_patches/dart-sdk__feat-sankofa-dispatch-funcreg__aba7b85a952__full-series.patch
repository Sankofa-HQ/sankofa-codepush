+// Little-endian byte buffer for the DD binary artifacts (dd_table /
+// dd_caller_links). Sankofa owns both producer (analyze_snapshot) and
+// consumer (gen_snapshot), so the format is ours to define.
+class DdBuf {
+ public:
+  void U32(uint32_t v) {
+    for (int i = 0; i < 4; i++) b_.push_back((v >> (8 * i)) & 0xFF);
+  }
+  void U64(uint64_t v) {
+    for (int i = 0; i < 8; i++) b_.push_back((v >> (8 * i)) & 0xFF);
+  }
+  const uint8_t* data() const { return b_.data(); }
+  size_t size() const { return b_.size(); }
+
+ private:
+  std::vector<uint8_t> b_;
+};
+
+bool DdWriteFile(const char* path, const DdBuf& buf) {
+  if (path == nullptr) return false;
+  std::FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) return false;
+  const size_t w =
+      buf.size() ? std::fwrite(buf.data(), 1, buf.size(), f) : 0;
+  std::fclose(f);
+  return w == buf.size();
+}
