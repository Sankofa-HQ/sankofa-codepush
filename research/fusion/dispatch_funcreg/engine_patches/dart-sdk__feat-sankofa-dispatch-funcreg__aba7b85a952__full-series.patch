+// Sankofa CodePush: detect a Mach-O fat (universal) binary at file_offset
+// and return the file offset of the arm64 slice (or -1 if not a fat
+// binary / no arm64 slice). Fat header fields are big-endian.
+static int64_t TryFindMachOFatArm64Slice(File& file, int64_t file_offset) {
+  uint8_t header[8];
+  if (!file.SetPosition(file_offset) ||
+      !file.ReadFully(header, sizeof(header))) {
+    return -1;
+  }
+  // FAT_MAGIC = 0xCAFEBABE (big-endian on disk), FAT_CIGAM = 0xBEBAFECA.
+  // FAT_MAGIC_64 = 0xCAFEBABF / FAT_CIGAM_64 = 0xBFBAFECA.
+  const uint32_t magic = (static_cast<uint32_t>(header[0]) << 24) |
+                         (static_cast<uint32_t>(header[1]) << 16) |
+                         (static_cast<uint32_t>(header[2]) << 8) |
+                         (static_cast<uint32_t>(header[3]));
+  const bool is_fat32 = magic == 0xCAFEBABEu;
+  const bool is_fat64 = magic == 0xCAFEBABFu;
+  if (!is_fat32 && !is_fat64) {
+    return -1;
+  }
+  // nfat_arch is big-endian.
+  const uint32_t nfat_arch = (static_cast<uint32_t>(header[4]) << 24) |
+                             (static_cast<uint32_t>(header[5]) << 16) |
+                             (static_cast<uint32_t>(header[6]) << 8) |
+                             (static_cast<uint32_t>(header[7]));
+  // CPU_TYPE_ARM64 = 0x0100000C. (CPU_ARCH_ABI64 | CPU_TYPE_ARM)
+  const uint32_t kCpuTypeArm64 = 0x0100000Cu;
+  // fat_arch is 20 bytes (32-bit fat) or 32 bytes (64-bit fat).
+  const intptr_t arch_size = is_fat64 ? 32 : 20;
+  for (uint32_t i = 0; i < nfat_arch; i++) {
+    uint8_t arch[32];
+    if (!file.SetPosition(file_offset + 8 + i * arch_size) ||
+        !file.ReadFully(arch, arch_size)) {
+      return -1;
+    }
+    const uint32_t cputype = (static_cast<uint32_t>(arch[0]) << 24) |
+                             (static_cast<uint32_t>(arch[1]) << 16) |
+                             (static_cast<uint32_t>(arch[2]) << 8) |
+                             (static_cast<uint32_t>(arch[3]));
+    if (cputype != kCpuTypeArm64) continue;
+    int64_t slice_offset;
+    if (is_fat64) {
+      // offset is bytes [8..16], 64-bit big-endian.
+      slice_offset = 0;
+      for (int b = 0; b < 8; b++) {
+        slice_offset = (slice_offset << 8) | arch[8 + b];
+      }
+    } else {
+      slice_offset = (static_cast<int64_t>(arch[8]) << 24) |
+                     (static_cast<int64_t>(arch[9]) << 16) |
+                     (static_cast<int64_t>(arch[10]) << 8) |
+                     (static_cast<int64_t>(arch[11]));
+    }
+    return slice_offset;
+  }
+  return -1;
+}
