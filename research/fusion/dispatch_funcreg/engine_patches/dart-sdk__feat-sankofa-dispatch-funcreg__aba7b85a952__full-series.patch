+// Use of this source code is governed by an Apache-2.0 license that can be
+// found in the LICENSE file.
+//
+// Sankofa CodePush — patch-side link-data readers. Each Dart_LoadSankofa*
+// function parses a file written by the corresponding Dart_WriteSankofa*
+// emitter (sankofa_codepush_emit.cc) and stores it in a thread-local
+// LinkData singleton the precompiler consults during patch-aligned
+// compilation.
+//
+// File formats are documented in sankofa_codepush_emit.cc.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "include/analyze_snapshot_api.h"
+#include "vm/globals.h"
