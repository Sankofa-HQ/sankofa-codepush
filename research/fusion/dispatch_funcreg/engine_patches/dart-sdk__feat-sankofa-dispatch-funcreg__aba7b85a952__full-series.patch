+// Returns a short stable identity string for a tagged-object pool
+// entry (function-qualified-name, string content, class name+id, etc.).
+// Reuses the same logic as SankofaSnapshotAnalyzer::HashTaggedObjectIdentity
+// but in textual form for the link-data file.
+std::string TaggedIdentityCString(const Object& obj) {
+  if (obj.IsNull()) return "<null>";
+  char buf[64];
+  if (obj.IsSmi()) {
+    std::snprintf(buf, sizeof(buf), "Smi:%lld",
+                  static_cast<long long>(Smi::Cast(obj).Value()));
+    return buf;
+  }
+  if (obj.IsMint()) {
+    std::snprintf(buf, sizeof(buf), "Mint:%lld",
+                  static_cast<long long>(Mint::Cast(obj).Value()));
+    return buf;
+  }
+  if (obj.IsBool()) {
+    return Bool::Cast(obj).value() ? "Bool:true" : "Bool:false";
+  }
+  if (obj.IsDouble()) {
+    std::snprintf(buf, sizeof(buf), "Double:%g", Double::Cast(obj).value());
+    return buf;
+  }
+  if (obj.IsString()) {
+    const char* cstr = String::Cast(obj).ToCString();
+    return std::string("Str:") + (cstr != nullptr ? cstr : "");
+  }
+  if (obj.IsClass()) {
+    const char* cstr = Class::Cast(obj).ScrubbedNameCString();
+    std::snprintf(buf, sizeof(buf), "Class:%ld:%s",
+                  static_cast<long>(Class::Cast(obj).id()),
+                  cstr != nullptr ? cstr : "");
+    return buf;
+  }
+  if (obj.IsFunction()) {
+    const char* qname =
+        Function::Cast(obj).QualifiedScrubbedNameCString();
+    return std::string("Fn:") + (qname != nullptr ? qname : "");
+  }
+  if (obj.IsCode()) {
+    if (Code::Cast(obj).owner() != Object::null()) {
+      const Object& owner = Object::Handle(Code::Cast(obj).owner());
+      return TaggedIdentityCString(owner);
+    }
+    std::snprintf(buf, sizeof(buf), "Code:size=%ld",
+                  static_cast<long>(Code::Cast(obj).Size()));
+    return buf;
+  }
+  if (obj.IsField()) {
+    const String& name =
+        String::Handle(Field::Cast(obj).name());
+    return std::string("Field:") +
+           (name.IsNull() ? "" : name.ToCString());
+  }
+  std::snprintf(buf, sizeof(buf), "cid:%ld",
+                static_cast<long>(obj.GetClassId()));
+  return buf;
+}
