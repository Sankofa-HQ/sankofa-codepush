+
+// After |name| has been transplanted to bytecode, reroute every dispatch-table
+// slot that held |old_entry| (its pre-transplant code entry) to the
+// SankofaDispatchInterpret trampoline, and set the slot's function-half to the
+// (now bytecode) Function so the trampoline can load FUNCTION_REG. This makes an
+// UNCHANGED base-AOT dispatch-table call (e.g. framework -> build()) reach the
+// interpreted body with no flag, no JIT. Returns slots repointed, or -1.
+intptr_t Dart_SankofaRepointDispatchToInterpret(const char* name,
