From aba7b85a9524a502606d5e080013cf604aa0665f Mon Sep 17 00:00:00 2001
From: Sankofa <dev@sankofa.dev>
Date: Tue, 30 Jun 2026 15:53:23 +0000
Subject: [PATCH 8/8] dispatch-funcreg: enriched interpreter Trap diagnostic
 (fn/bytecode/pc_off/depth)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

At the interpreter Trap label, FATAL now reports the function name, has_bytecode,
bytecode base+size, pc_offset, in_range, and frame depth — classifying a Trap as
ran-off-end / wrong-frame / real-trap. This one diagnostic pinpointed the
live-render crash in a single device run: Trap op=0 fn=Panel.label has_bc=1
size=7 pc_off=0 in_range=1 depth=0 => valid Bytecode object whose instructions_
pointed at zeroed memory (the patch mapping had been unmapped).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 runtime/vm/interpreter.cc | 46 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 41 insertions(+), 5 deletions(-)

diff --git a/runtime/vm/interpreter.cc b/runtime/vm/interpreter.cc
index db6afb4c11d..6b202f774b9 100644
--- a/runtime/vm/interpreter.cc
+++ b/runtime/vm/interpreter.cc
@@ -3423,11 +3423,47 @@ SwitchDispatchNoSingleStep:
     BYTECODE_ENTRY_LABEL(VMInternal_Breakpoint_A_B_C)
 #endif  // defined(PRODUCT)
 
-    // Sankofa: report the exact unimplemented opcode in the FATAL message
-    // itself (FATAL IS captured by devicectl --console; OS::PrintErr is not).
-    FATAL("[sankofa] unimplemented interpreter opcode=%u bytes=%u,%u,%u",
-          static_cast<unsigned>(pc[0]), static_cast<unsigned>(pc[1]),
-          static_cast<unsigned>(pc[2]), static_cast<unsigned>(pc[3]));
+    // Sankofa: emit a DECISIVE Trap report (FATAL is captured by devicectl
+    // --console; OS::PrintErr is not). Classifies the Trap:
+    //   pc_off <  0       => PC is BEFORE the bytecode  => wrong frame/function
+    //   pc_off >= size    => PC ran OFF THE END of valid bytecode => frame/entry
+    //                        size mismatch (interpreter walked past the body)
+    //   0 <= pc_off < size => a real Trap inside valid bytecode (genuine
+    //                        unreachable reached, or a corrupt instruction).
+    {
+      Thread* sk_thread = Thread::Current();
+      FunctionPtr sk_fn = FrameFunction(FP);
+      const bool sk_has_bc =
+          (sk_fn != Function::null()) && Function::HasBytecode(sk_fn);
+      uword sk_base = 0;
+      intptr_t sk_size = 0;
+      intptr_t sk_off = -1;
+      if (sk_has_bc) {
+        BytecodePtr sk_bc = Function::GetBytecode(sk_fn);
+        sk_base = sk_bc->untag()->instructions_;
+        sk_size = sk_bc->untag()->instructions_size_;
+        sk_off = reinterpret_cast<intptr_t>(pc) - static_cast<intptr_t>(sk_base);
+      }
+      intptr_t sk_depth = 0;
+      ObjectPtr* sk_f = FP;
+      while (sk_f != nullptr && sk_depth < 8192) {
+        const KBCInstr* sk_cpc = SavedCallerPC(sk_f);
+        if (sk_cpc == nullptr || IsEntryFrameMarker(sk_cpc)) break;
+        sk_f = SavedCallerFP(sk_f);
+        sk_depth++;
+      }
+      const char* sk_name = "<null>";
+      if (sk_thread != nullptr && sk_fn != Function::null()) {
+        sk_name =
+            Function::Handle(sk_thread->zone(), sk_fn).ToFullyQualifiedCString();
+      }
+      FATAL("[sankofa] Trap op=%u next=%u,%u,%u fn=%s has_bc=%d base=%#" Px
+            " size=%" Pd " pc_off=%" Pd " in_range=%d depth=%" Pd,
+            static_cast<unsigned>(pc[0]), static_cast<unsigned>(pc[1]),
+            static_cast<unsigned>(pc[2]), static_cast<unsigned>(pc[3]), sk_name,
+            sk_has_bc ? 1 : 0, sk_base, sk_size, sk_off,
+            (sk_off >= 0 && sk_off < sk_size) ? 1 : 0, sk_depth);
+    }
     DISPATCH();
   }
 
